// Publish the model as a global.  KAG3's system/Menus.tjs declares
// `class KAGMenuItem extends MenuItem` at global scope (and builds its whole
// system menu from it), so the public alias has to be reachable there.
// Preserve the released capability boundary for every title. The old class
// declaration was hoisted to global even for games with a compat layer.
// Keep a plain alias so an explicitly linked native or game class takes priority.
if (typeof(global.MenuItem) == "undefined") {
	global.MenuItem = KrkrnsScriptMenuItem;
}
global.__krkrnsScriptMenuClass = KrkrnsScriptMenuItem;

// Window constructs and owns one root per instance, and invalidates that root
