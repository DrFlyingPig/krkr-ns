        if (typeof(item) != "Object" || item === null ||
            typeof(item.__krkrnsNativeMenu) != "undefined")
            throw new Exception("Please specify a script MenuItem class object.");
        if (typeof(item.__krkrnsScriptMenu) != "undefined" && item._windowOwner !== null)
            throw new Exception("A Window menu root cannot be attached as a child.");
        var ancestor = this;
        while (ancestor !== null) {
