        validateChild(item);
        index = (int)index;
        if (index < 0 || index > _children.count) throw new Exception("Menu item index out of range.");
        var previous = childParent(item);
        if (previous !== null && previous !== void) previous.remove(item);
        if (index > _children.count) index = _children.count;
        setChildParent(item, this);
