// KRKR-ns compat: KAG2 plugin classes unavailable on Switch.
//
// Install exactly once per process.  Ending a game returns to the built-in
// launcher and the next game re-executes every compat script; TJS raises on a
// repeated `class` definition and ABORTS the remainder of the script, so the
// static members bound further down (WIN32Dialog.Header, ICC_USEREX_CLASSES,
// Scripts.getObjectKeys, ...) would silently never be installed and the next
// game's boot would fail on missing members.  The guard makes every re-run a
// no-op instead.
if (typeof(global.__krkrns_compat_k2compat) == "undefined") {
global.__krkrns_compat_k2compat = true;

// Kirikiroid2-compatible distributions ship their own compat layer at
// k2compat/k2compat.tjs.  It is deliberately NOT executed: our file shadows
// its basename, and its main job -- deleting MenuItem / Window.menu so a KAGEX
// title falls back to its own menu model -- is unnecessary now that the engine
// exposes neither (kirikiri2 keeps both inside menu.dll, which this port does
// not have).  Running it instead installs machinery of its own that expects
// engine members this port lacks: its stayOnTop property reads
// Window.mainWindow, and LimeLight died at boot on exactly that read.  Its
// presence is still what decides whether the script-side MenuItem model below
// may be published, so it is detected either way.
if (typeof(global.__krkrns_game_k2compat) == "undefined" ||
	global.__krkrns_game_k2compat == "")
{
	global.__krkrns_no_game_layer = true;
}

class DebugConsoleCompatDialog {
    function DebugConsoleCompatDialog(owner) {
        this.owner = owner;
        this.items = new Array();
        this.count = 0;
    }
    function show() { return null; }
    function execute() { return null; }
    function close() { return null; }
    function addItem(item) { return this; }
    function setTitle(t) { return this; }
    function getText() { return null; }
    function print(msg) { return null; }
}
if (typeof(Debug.console) == "undefined")
    Debug.console = new DebugConsoleCompatDialog(null);

// Desktop KAG builds can automatically open a native debug pad whenever a
// recoverable command warning is emitted.  Switch has no secondary desktop
// window, so keep warnings in the normal KRKR log unless a launcher/user has
// explicitly selected another value.
if (System.getArgument("-autoerrlogopen") == "")
    System.setArgument("-autoerrlogopen", "no");

// windowEx/Krkr2Compat normally provides Pad lazily.  A number of KAG systems
// define their LogWindow as `class ... extends Pad` even in release builds, so
// retain the script contract with an inert, stateful modeless window.  It is
// deliberately UI-agnostic: diagnostics remain available through Debug/logs,
// while normal game input continues through the SDL Window.
if (typeof(global.Pad) == "undefined") {
    class Pad {
        var owner;
        var visible = false;
        var left = 0;
        var top = 0;
        var width = 640;
        var height = 480;
        var text = "";
        var statusText = "";

        function Pad(owner) { this.owner = owner; }
        function finalize() { visible = false; owner = void; }
        function show() { visible = true; return this; }
        function close() {
            visible = false;
            if (typeof this.onClose == "Object") this.onClose();
            return this;
        }
        function setPos(x, y, w, h) {
            if (x !== void) left = x;
            if (y !== void) top = y;
            return setSize(w, h);
        }
        function setSize(w, h) {
            if (w !== void) width = w;
            if (h !== void) height = h;
            return this;
        }
    }
}

// KAG2 compatibility namespace object (plugin-provided in the original).
// Assigned rather than declared as a bare `function`: inside the install guard
// below a function declaration is block-scoped, so it would not become a
// global when this script runs as a function body.
//
// Additive: the deferral block at the top of this file has already executed
// the distribution's own Kirikiroid2 compat layer, whose Krkr2CompatUtils is
// the authoritative object (it carries members this file never knew about,
// e.g. `require` and the module loaders built on it).  Never replace it.
if (typeof(global.Krkr2CompatUtils) == "undefined" || global.Krkr2CompatUtils === null)
	global.Krkr2CompatUtils = function() {};
if (typeof(Krkr2CompatUtils.getMouseCursorPos) == "undefined")
	Krkr2CompatUtils.getMouseCursorPos = function() { return null; };
if (typeof(Krkr2CompatUtils.getWindowRect) == "undefined")
	Krkr2CompatUtils.getWindowRect = function() { return null; };

// Do not synthesize BaseConductorExtendClass here.  KAG's Conductor.tjs falls
// back to its complete built-in KAGParser when KAGParserEx.dll is unavailable;
// an empty stand-in would discard parser state such as debugLevel/ignoreCR.

// Provided by menu.dll in the original. Switch has no native desktop menu bar,
// but KAG still builds and queries the complete menu tree during start-up.
// Keep a script-side tree with the same observable members so menu creation is
// harmless and controller/touch driven games can continue to their own UI.
class MenuItem {
    function MenuItem(owner, caption) {
        this.owner = owner;
        this.caption = caption;
        this.text = caption;
        this.command = null;
        this.enabled = true;
        this.accessible = true;
        this.checked = false;
        this.visible = true;
        this.radio = false;
        this.group = 0;
        this.index = 0;
        this.parent = null;
        this.children = new Array();
    }
    // shortcut is a STRING here, exactly as in kirikiri2: its native property
    // stores what SetShortcut(ttstr) produced, so an integer assignment comes
    // back as text.  KAGEX relies on that -- it creates items with shortcut 0
    // (no shortcut) and later runs shortcut.split("+"); a raw integer throws
    // "Cannot convert the variable type ((int)0 to Object)", which aborts the
    // fullscreen transition it was in the middle of (LimeLight sat white at
    // boot).  Every assignment is therefore stringified.
    var _shortcut = "";
    property shortcut {
        getter { return _shortcut; }
        setter(v) { _shortcut = (v === void) ? "" : (string)v; }
    }
    function setText(t) { this.text = t; this.caption = t; return this; }
    function getText() { return this.text; }
    function setEnabled(e) { this.enabled = e; return this; }
    function isEnabled() { return this.enabled; }
    function setChecked(c) { this.checked = c; return this; }
    function isChecked() { return this.checked; }
    function setVisible(v) { this.visible = v; return this; }
    function isVisible() { return this.visible; }
    function setCommand(c) { this.command = c; return this; }
    function getCommand() { return this.command; }
    function add(item) {
        if (item === void || item === null) return this;
        item.parent = this;
        this.children.add(item);
        return item;
    }
    function insert(item, index) {
        if (item === void || item === null) return this;
        item.parent = this;
        if (index < 0 || index >= this.children.count) this.children.add(item);
        else this.children.insert(index, item);
        return item;
    }
    function remove(item) {
        var index = this.children.find(item);
        if (index >= 0) this.children.remove(index, 1);
        if (item !== void && item !== null) item.parent = null;
        return item;
    }
    function click() {
        if (!this.enabled || !this.accessible) return null;
        if (this.command !== null && typeof this.command == "Object")
            return this.command(this);
        return this.onClick();
    }
    function fireClick() { return this.click(); }
    function popup(flags, x, y) { return 0; }
    function onClick() { return null; }
    function addHook(h) { return this; }
    function removeHook(h) { return this; }
    function finalize() { this.children.clear(); this.parent = null; return null; }
}

// MenuItemEx (the windowEx.dll extension of MenuItem) adds the system-bitmap
// constants KAGEX uses to build its window control menu -- the fullscreen
// transition ends in SetWindowControlMenu, which failed with
// Member "biMinimize" does not exist and left the title on a white screen.
// Values are the stock Windows menu bitmap ids, exactly as the plugin defines
// them (upstream-krkr2 cpp/plugins/windowEx.cpp).
MenuItem.biSystem           = 1;
MenuItem.biRestore          = 2;
MenuItem.biMinimize         = 3;
MenuItem.biClose            = 5;
MenuItem.biCloseDisabled    = 6;
MenuItem.biMinimizeDisabled = 7;
MenuItem.biPopupClose       = 8;
MenuItem.biPopupRestore     = 9;
MenuItem.biPopupMaximize    = 10;
MenuItem.biPopupMinimize    = 11;

// The rest of MenuItemEx's surface.  bmpItem/bmpChecked/bmpUnchecked accept a
// Layer (or null) and are only read back by the plugin that draws the menu
// bar, which does not exist here; rightJustify decides the text alignment the
// titles set on their window-control items.
if (typeof(MenuItem.prototype) == "object" || true) {
    if (typeof(global.__krkrns_menu_ex) == "undefined") {
        global.__krkrns_menu_ex = true;
        MenuItem.bmpItem      = null;
        MenuItem.bmpChecked   = null;
        MenuItem.bmpUnchecked = null;
        MenuItem.rightJustify = false;
    }
}

// Publish the model as a global.  KAG3's system/Menus.tjs declares
// `class KAGMenuItem extends MenuItem` at global scope (and builds its whole
// system menu from it), so the name has to be reachable there; a class
// declared inside this guard block is block-scoped and never becomes a global
// on its own.  Titles that ship a Kirikiroid2 compat layer are excluded --
// they bring their own menu model and never reference this name.  Keep it a
// plain global member so a title's layer can still delete it.
if (typeof(global.MenuItem) == "undefined") {
	if (typeof(global.__krkrns_no_game_layer) != "undefined") global.MenuItem = MenuItem;
}

// Kirikiri's Window.menu property lazily returns a root MenuItem.  Native
// desktop ports attach a platform menu here; on Switch one shared inert root
// provides the same script contract without trying to create OS widgets.
if (typeof(Window.menu) == "undefined") Window.menu = new MenuItem(null, "");
// Native window handles are a Win32-only implementation detail.  Scripts pass
// this value to optional desktop plugins; zero is the conventional null handle.
if (typeof(Window.HWND) == "undefined") Window.HWND = 0;

// windowEx.dll exposes Win32 message-hook controls. Switch receives input
// through SDL, so native Windows messages do not exist; retain the public
// method contract and the notification IDs used while KAG builds key maps.
Window.getNotificationNum = function(name) {
    if (name == "KEYDOWN") return 0x0100;
    if (name == "KEYUP") return 0x0101;
    if (name == "CHAR") return 0x0102;
    if (name == "SYSKEYDOWN") return 0x0104;
    if (name == "SYSKEYUP") return 0x0105;
    if (name == "SYSCHAR") return 0x0106;
    return -1;
};
Window.getNotificationName = function(number) {
    if (number == 0x0100) return "KEYDOWN";
    if (number == 0x0101) return "KEYUP";
    if (number == 0x0102) return "CHAR";
    if (number == 0x0104) return "SYSKEYDOWN";
    if (number == 0x0105) return "SYSKEYUP";
    if (number == 0x0106) return "SYSCHAR";
    return "";
};
Window.setMessageHook = function(enable, number) { return false; };
Window.registerExEvent = function(name) { return true; };

// Keep the remaining windowEx state on the TJS Window object.  These values
// affect Win32 chrome/system menus only; retaining them lets games assign and
// query the documented members without introducing a second platform window.
if (typeof(Window.disableResize) == "undefined") Window.disableResize = false;
if (typeof(Window.enableNCMouseEvent) == "undefined") Window.enableNCMouseEvent = false;
if (typeof(Window.disableMove) == "undefined") Window.disableMove = false;

// windowEx.dll also answers the window geometry queries.  KAGEX's fullscreen
// transition reads these before switching (it remembers the windowed rect and
// restores it later); without them the setter aborts halfway, leaves
// _fullScreenChanging set and the boot wait never completes -- which is why
// the TJS-visible fullScreen was once forced true here.  Reporting the real
// window rect instead lets the transition finish, and keeps fullScreen
// truthful, which the games' own sizing logic depends on (their setZoom()
// returns early when fullScreen is true, so a forced true skips the
// window-size setup and leaves a mis-sized stage behind).
// The rect is reported in the window's own coordinates with the width/height
// spellings both kirikiri rect conventions use.
Window.getNormalRect = function() {
    var w = this.width, h = this.height;
    return %[ left:0, top:0, right:w, bottom:h,
              x:0, y:0, w:w, h:h,
              normalLeft:0, normalTop:0, normalRight:w, normalBottom:h ];
};
Window.getWindowRect = function() {
    var w = this.width, h = this.height;
    return %[ left:0, top:0, right:w, bottom:h, x:0, y:0, w:w, h:h ];
};
Window.getClientRect = function() {
    var w = this.innerWidth, h = this.innerHeight;
    return %[ left:0, top:0, right:w, bottom:h, x:0, y:0, w:w, h:h ];
};
Window.setClientRect = function(r) { return true; };
Window.getPlacement = function() {
    var w = this.width, h = this.height;
    return %[ normalLeft:0, normalTop:0, normalRight:w, normalBottom:h,
              showCmd:1, flags:0, minPosition:0, maxPosition:0 ];
};
Window.setPlacement = function(p) { return true; };

// Window state that windowEx.dll keeps for the title's own window manager.
// KAGEX's fullscreen/size transition (LimeLight's mainwindow.tjs setZoom and
// friends) reads and writes all of these while it remembers the windowed state
// and restores it after going fullscreen; a missing member aborts that
// transition (the session died on Member "maximized" does not exist) and the
// title ends up on a black screen.  These are bookkeeping values for a
// single-window console -- there is no OS chrome to maximize or move -- so
// they are kept script-side with sane defaults and never refuse an assignment.
if (typeof(Window.maximized) == "undefined")    Window.maximized = false;
if (typeof(Window.restmax) == "undefined")      Window.restmax = false;
if (typeof(Window.restoreMaximize) == "undefined") Window.restoreMaximize = function() { return null; };
if (typeof(Window.callResize) == "undefined")   Window.callResize = false;
if (typeof(Window.resetIcon) == "undefined")    Window.resetIcon = false;
if (typeof(Window.resetWindowMaxSize) == "undefined") Window.resetWindowMaxSize = function() { return null; };
if (typeof(Window.disableMove) == "undefined")  Window.disableMove = false;
if (typeof(Window.pseudoFullScreened) == "undefined") Window.pseudoFullScreened = false;
if (typeof(Window.isPseudoMode) == "undefined") Window.isPseudoMode = function() { return false; };
// Screen/window rectangles.  KAGEX keeps its own copy of these while it
// switches modes; answering with the live values keeps that copy consistent.
Window.windowPos = %[ x:0, y:0 ];
Window.setScreenRect = function(r) { return true; };
Window.getScreenRect = function() {
    return %[ left:0, top:0, right:System.screenWidth, bottom:System.screenHeight,
              x:0, y:0, w:System.screenWidth, h:System.screenHeight ];
};
Window.setPrimarySize = function(w, h) { return true; };
Window.getSystemMetrics = function(name) {
    // Win32 metrics the titles ask for while laying out their window edge.
    if (name == "CXSIZEFRAME") return 0;
    if (name == "CYSIZEFRAME") return 0;
    if (name == "CYCAPTION")   return 0;
    if (name == "CYMENU")      return 0;
    return 0;
};
Window.getMonitorInfo = function() { return void; };

// NOTE: minimize / maximize / showRestore / resetWindowIcon / setWindowIcon are
// deliberately NOT defined.  They are windowEx.dll's, and KAGEX uses their
// presence as the capability probe: SetWindowControlMenu() starts with
// "if (typeof win.minimize != 'Object') return;" and otherwise builds a menu
// out of MenuItemEx members that exist on Windows only.  Kirikiroid2 leaves
// them undefined too, and the titles distributed for it rely on that fallback.

Window.setOverlayBitmap = function() { return null; };
Window.ncHitTest = function(x, y) { return false; };
Window.focusMenuByKey = function(key) { return false; };
Window.bringTo = function(target) { return null; };
Window.sendToBack = function() { return null; };

// gamepad.dll is a Windows polling plugin.  SDLApplication already translates
// Switch controllers into the normal Kirikiri mouse/key events, so expose an
// empty plugin-shaped port to stop KAGEX from installing a second poller.
if (typeof(GamepadPort) == "undefined") {
    class GamepadPort {
        function GamepadPort() { this.count = 0; }
        function initialize(hwnd) { this.count = 0; return true; }
        function getController(index) { return null; }
        function finalize() { this.count = 0; }
    }
}

// Button masks published by gamepad.dll.  Some KAGEX scripts build mapping
// tables at class-load time even when no plugin controller is present.
if (typeof(global.gpButtonDpadUp) == "undefined") {
    global.gpButtonDpadUp        = 0x00000001;
    global.gpButtonDpadDown      = 0x00000002;
    global.gpButtonDpadLeft      = 0x00000004;
    global.gpButtonDpadRight     = 0x00000008;
    global.gpButtonA             = 0x00000010;
    global.gpButtonB             = 0x00000020;
    global.gpButtonX             = 0x00000040;
    global.gpButtonY             = 0x00000080;
    global.gpButtonLeftShoulder  = 0x00000100;
    global.gpButtonRightShoulder = 0x00000200;
    global.gpLeftTrigger         = 0x00000400;
    global.gpRightTrigger        = 0x00000800;
    global.gpButtonBack          = 0x00001000;
    global.gpButtonStart         = 0x00002000;
    global.gpButtonLeftThumb     = 0x00004000;
    global.gpButtonRightThumb    = 0x00008000;
    global.gpTouchDown           = 1;
}

if (typeof(Krkr2CompatUtils.loadPlugin) == "undefined")
	Krkr2CompatUtils.loadPlugin = function(name) { return null; };
if (typeof(Krkr2CompatUtils.unloadPlugin) == "undefined")
	Krkr2CompatUtils.unloadPlugin = function(name) { return null; };
if (typeof(Krkr2CompatUtils.isLoaded) == "undefined")
	Krkr2CompatUtils.isLoaded = function(name) { return true; };
if (typeof(Krkr2CompatUtils.autoLoad) == "undefined")
	Krkr2CompatUtils.autoLoad = function() { return null; };
if (typeof(Krkr2CompatUtils.Window) == "undefined")
	Krkr2CompatUtils.Window = function() { return null; };

// KAGParserEx normally extends Scripts with object helpers.  Reuse the
// engine's native Dictionary enumeration methods; TJS2 does not implement
// JavaScript's `for (key in object)` syntax.
Scripts.getObjectKeys = function(object) { return Dictionary.keys(object); };
Scripts.getObjectValues = function(object) { return Dictionary.values(object); };
Scripts.hasObjectKey = function(object, key) { return Dictionary.contains(object, key); };

// addFont.dll exposes System.addFont on Windows.  krkrsdl2 already has the
// equivalent archive-aware FreeType implementation as Font.addFont.
System.addFont = function(storage) { return Font.addFont(storage); };

// win32dialog.dll is unavailable on Switch, and the titles that use it ship
// Kirikiroid2's TJS replacement inside the very layer these compat files stand
// in for, so the call has to exist here.  KAG's data-comment editor called
// System.inputString and died on "Member inputString does not exist": the
// button next to "delete" on the save screen did nothing at all.  There is no
// on-screen editor to type into yet, so hand back the stored comment and let
// the caller write its page -- the comment stays as it was instead of the
// whole action failing.  (The property-reference form is what TJS wants when
// the target member lives on a class object.)
if (typeof(System.inputString) == "undefined") {
	&System.inputString = function (caption, prompt, initial) {
		if (typeof(initial) == "undefined") return "";
		return initial;
	} incontextof global;
}

// The save screen's delete needs a TJS-level property on the class object to
// reach the engine.  Without it the call the game makes silently does nothing:
// the dialog answers, the page refreshes, no file is deleted and no error is
// raised anywhere (checked against the same build with and without this
// wrapper -- with it, savedata019.bmp left the disk, without it the engine's
// deleteFile entry log never fired).  So the member is re-published as a plain
// TJS function that forwards to the native one, and every call is logged.
if (typeof(Storages.deleteFile) != "undefined" && typeof(global.__krkrns_deletefile_wrapped) == "undefined")
{
	global.__krkrns_deletefile_wrapped = true;
	global.__krkrns_deletefile_native = Storages.deleteFile;
	&Storages.deleteFile = function (name) {
		System.inform("Storages.deleteFile(" + name + ")");
		return global.__krkrns_deletefile_native(name);
	} incontextof global;
}

// Self-test (temporary): prove the whole delete path on a scratch file the
// test harness drops next to the launcher, so the fix can be checked without
// clicking through the save screen.  System.inform is a log channel here.
if (typeof(global.__krkrns_diag_delete_probe) == "undefined")
{
	global.__krkrns_diag_delete_probe = true;
	try
	{
		var probe = "file://sdmc:/switch/KRKR-ns/krkrns-delete-probe.bmp";
		if (Storages.isExistentStorage(probe))
		{
			var ok = Storages.deleteFile(probe);
			System.inform("KRKR-ns diag: delete probe -> " + ok
				+ " exists_after=" + Storages.isExistentStorage(probe));
		}
		else
		{
			System.inform("KRKR-ns diag: delete probe file not present");
		}
	}
	catch (e)
	{
		System.inform("KRKR-ns diag: delete probe threw: " + e.message);
	}
}


} // __krkrns_compat_k2compat (install once per process)
