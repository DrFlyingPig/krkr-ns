// back to its complete built-in KAGParser when KAGParserEx.dll is unavailable;
// an empty stand-in would discard parser state such as debugLevel/ignoreCR.

// menu.dll can explicitly install the native class. Games without their own
// Kirikiroid2 menu layer use this tree; both paths share the layer-based popup.
Scripts.execStorage("file://?/romfs:/compat/system/menu_popup.tjs");
// Use a private name: TJS hoists top-level class declarations even when they
// occur inside an if block. Naming this class MenuItem replaces menu.dll's
// native class before the conditional publication below can run.
class KrkrnsScriptMenuItem {
    var owner, command = null, accessible = true;
