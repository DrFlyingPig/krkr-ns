                for (var i = 0; i < _children.count; i++) _childrenView.add(_children[i]);
                _childrenValid = true;
            }
            return _childrenView;
        }
    }
    property root {
        getter {
            var item = this;
            while (item._parent !== null) item = item._parent;
            return item;
        }
    }
    property window { getter { return root._windowOwner; } }
    property index {
        getter { return _parent === null ? 0 : _parent._children.find(this); }
        setter(v) {
            if (_parent === null) return;
            v = (int)v;
            if (v < 0 || v >= _parent._children.count) throw new Exception("Menu item index out of range.");
            var siblings = _parent._children;
            siblings.erase(siblings.find(this));
            siblings.insert(v, this);
            _parent._childrenValid = false;
        }
    }
    property checked {
        getter { return _checked; }
        setter(v) {
            v = !!v;
            if (v && radio && _parent !== null) {
                for (var i = 0; i < _parent._children.count; i++) {
                    var sibling = _parent._children[i];
                    if (sibling.radio && sibling.group == group) sibling._checked = false;
                }
            }
            _checked = v;
        }
    }
