// KRKR-ns compat: restore the KAG2 compatibility namespace.
//
// A game's boot sequence loads its own system/k2compat.tjs (KAG ships a desktop
// copy), and that file REPLACES global.Krkr2CompatUtils with its own object --
// which expects the real k2compat.dll to supply loadPlugin/unloadPlugin/isLoaded
// /autoLoad.  On Switch that plugin does not exist, so after the first game the
// namespace exists but its members are gone and the next game dies during boot:
//
//   initialize.tjs[KAGLoadScript] <-- initialize.tjs[KAGLoadScriptOnce]
//     <-- custom.tjs(20)  Member "loadPlugin" does not exist
//
// k2compat.tjs is installed once per process (see its install guard), so it
// cannot repair this by running again.  SDLApplication.cpp therefore executes
// THIS file at every session boundary, before the next game can boot.
//
// Re-run this whole file: the plugin probe, the .psb motion handler and the
// -scanim answer below are idempotent re-installations.
//
// The namespace itself is now filled ADDITIVELY.  The distributions carry their
// own Kirikiroid2 compat layer (k2compat/k2compat.tjs, executed by our stub),
// whose Krkr2CompatUtils is the authoritative one -- it has members this file
// never knew about (require, and the module loaders built on it).  Overwriting
// the object took `require` away from k2compat/k2compat_pad.tjs, which then
// died with `Member "require" does not exist` right after the layer loaded.
// So: create the object only when there is none, and add only members that are
// missing (an earlier game's desktop shell is still shadowed by our stub, so
// its broken variants never reach this point).
if (typeof(global.Krkr2CompatUtils) == "undefined" || global.Krkr2CompatUtils === null)
	global.Krkr2CompatUtils = function() {};
if (typeof(Krkr2CompatUtils.scriptBase) == "undefined")
	Krkr2CompatUtils.scriptBase = "";
if (typeof(Krkr2CompatUtils.getMouseCursorPos) == "undefined")
	Krkr2CompatUtils.getMouseCursorPos = function() { return null; };
if (typeof(Krkr2CompatUtils.getWindowRect) == "undefined")
	Krkr2CompatUtils.getWindowRect = function() { return null; };
if (typeof(Krkr2CompatUtils.loadPlugin) == "undefined")
	Krkr2CompatUtils.loadPlugin = function(name) { return null; };
if (typeof(Krkr2CompatUtils.unloadPlugin) == "undefined")
	Krkr2CompatUtils.unloadPlugin = function(name) { return null; };
if (typeof(Krkr2CompatUtils.isLoaded) == "undefined")
	Krkr2CompatUtils.isLoaded = function(name) { return true; };
if (typeof(Krkr2CompatUtils.autoLoad) == "undefined")
	Krkr2CompatUtils.autoLoad = function(name) { return null; };
if (typeof(Krkr2CompatUtils.Window) == "undefined")
	Krkr2CompatUtils.Window = function() { return null; };

// ---------------------------------------------------------------------------
// AlphaMovie.dll (M2's alpha-channel movie plugin) is not available here.
//
// Titles that use it ship their glue in script/alphamovie.ks, whose whole body
// is guarded by
//   @if exp="typeof(global.alphamovie_object) == 'undefined'"
// and contains `class AlphaMoviePlayer extends AlphaMovie` plus the KAG tag
// definitions built on top of it.  Without the class the statement throws, the
// boot stops at a fatal error dialog that has no visible representation on
// this port (the user sees a black screen), and the tags never get defined.
//
// Pre-defining a model-only AlphaMovie lets the glue load intact.  The stub
// reports exactly one frame: the player's own handler then reaches its finish
// branch after about a second and fires `finish_alpha_movie_<slot>` /
// `next_alpha_movie_<slot>`, so no scenario waits forever on a movie that can
// never decode.  Nothing renders (there is no decoder), which is the same
// visible result as the missing plugin, minus the dead boot.
if (typeof(global.AlphaMovie) == "undefined") {
	class AlphaMovie {
		var loop = false;
		var numOfFrame = 1;
		var _opacity = 1.0;
		function AlphaMovie() { }
		function play() { }
		function stop() { }
		function setNextMovieFile(storage) { return; }
		// Frame advance entry point: report the last (only) frame so the
		// caller's finish/next handling runs.
		function showNextImage(layer) { return numOfFrame - 1; }
		property opacity { getter { return _opacity; } setter(v) { _opacity = v; } }
	}
}

// ---------------------------------------------------------------------------
// Plugin availability probe.
//
// Kirikiroid2 answers this from a built-in registry of reimplemented Windows
// plugins.  This port reimplements one so far: layerStwCopy.dll, whose single
// entry point Layer.stitchWrappedCopy now exists in the engine.  Report it, so
// titles that gate a feature on the probe take the plugin path.
//
// Why this matters: YuzuSoft's main\uisystem.tjs installs kag.sysTransitionEffect
// only when CanLoadPlugin("layerStwCopy.dll") answers true, while its options
// screen calls that member unconditionally.  Probing false leaves the member
// undefined and the screen throws on every frame instead of opening.
//
// ONLY this probe is overridden.  Plugins.link is left exactly as the game
// defined it: titles call it unconditionally and then use the class it is
// supposed to register -- `Plugins.link("motionplayer.dll")` followed by a read
// of `Motion`, with no probe in between -- so wrapping it silently breaks
// plugin-backed features that already worked.
//
// This file is re-executed after the game loads its own system/k2compat.tjs
// (which redefines CanLoadPlugin), so the wrapper here ends up outermost.  The
// definition it replaced is kept, and every other plugin still gets that
// original answer.
//
// TJS notes that shaped this code: reading an absent global THROWS ("Member X
// does not exist") so it is probed with typeof() first, and a `var` declared
// inside a block is invisible to a closure that outlives the block, so the
// saved definition lives on a global.
global.__krkrns_emulated_plugins = %[];
global.__krkrns_emulated_plugins["layerstwcopy.dll"] = true;

global.__krkrns_prev_can_load = null;
if (typeof(global.CanLoadPlugin) != "void" && typeof(global.CanLoadPlugin) != "undefined") {
    global.__krkrns_prev_can_load = global.CanLoadPlugin;
}
// Re-entrancy guard: distributions hook CanLoadPlugin / Plugins.link through
// their own compat layer (k2compat/k2compat.tjs), and such a hook commonly
// delegates back to the current global for names it does not know.  With this
// wrapper installed on top, that delegation re-enters the wrapper, which calls
// the saved definition again -- an endless mutual recursion that overflowed the
// guest stack at Voice.tjs (stack walked below SP into the guard page).  The
// flag turns any nested call into a plain `false`, which is what the base
// implementation would answer for the plugins this port cannot provide.
global.__krkrns_in_can_load = false;
global.CanLoadPlugin = function(name) {
    var hit = global.__krkrns_emulated_plugins[name.toLowerCase()];
    if (typeof(hit) != "void" && typeof(hit) != "undefined") {
        Debug.message("[compat] CanLoadPlugin(" + name + ") -> emulated");
        return true;
    }
    var prev = global.__krkrns_prev_can_load;
    if (prev != null && prev !== global.CanLoadPlugin && !global.__krkrns_in_can_load) {
        global.__krkrns_in_can_load = true;
        var r = false;
        // try/catch, not try/finally: this TJS2 grammar does not accept a
        // catch-less finally clause.
        try { r = prev(name); }
        catch (e) { global.__krkrns_in_can_load = false; throw e; }
        global.__krkrns_in_can_load = false;
        return r;
    }
    return false;
};

// ---------------------------------------------------------------------------
// .psb motion handler (sysscn/GFX_Motion.tjs).
//
// KAGEX titles draw their animated title background - and every [ev ...] logo /
// effect - through the flip type GFX_Motion.tjs registers for the "psb"
// extension.  That script sits in the scenario folder and is normally
// registered by the game's own scenario-plugin pass; in this engine nothing
// ever requests it, so GenericFlip.GetType("title_bg.psb") finds no handler,
// [title_bg show] draws nothing and the title screen stays black while
// [title_bg waitmovie] returns immediately.
//
// Load it ourselves once the KAG layer classes and the Motion plugin exist.
// Polled through a continuous handler because this file runs during k2compat,
// long before Initialize.tjs has defined GenericFlip or loaded motion.tjs.
// TJS notes that shaped this code: an absent global read THROWS so it is probed
// with typeof() first, and a `var` inside a block is invisible to a closure that
// outlives the block, so the handler lives on a global.
if (Storages.isExistentStorage("GFX_Motion.tjs")) {
    global.__krkrns_gfxm_tries = 0;
    global.__krkrns_gfxm_tick = function(tick) {
        // The whole body is wrapped: during the engine rebuild at a game exit
        // the globals this tick touches can be gone for one frame, and an
        // exception escaping a continuous handler is logged as a script error
        // (it used to be the "Accessing to null object" line after every exit).
        try {
            // typeof-guard: after an in-process engine rebuild (game exit ->
            // launcher) this handler can briefly outlive its globals, and an
            // absent TJS global THROWS on read.
            if (typeof(global.__krkrns_gfxm_tries) != "number")
                global.__krkrns_gfxm_tries = 0;
            global.__krkrns_gfxm_tries = global.__krkrns_gfxm_tries + 1;
            var ready = false;
            try {
                ready = typeof(global.GenericFlip) != "void" && typeof(global.GenericFlip) != "undefined";
                ready = ready && typeof(global.Motion) != "void" && typeof(global.Motion) != "undefined";
            } catch (e) {
                ready = false;
            }
            if (!ready) {
                if (global.__krkrns_gfxm_tries > 900) {
                    Debug.message("[compat] GFX_Motion.tjs: layer classes never appeared, giving up");
                    System.removeContinuousHandler(global.__krkrns_gfxm_tick);
                }
                return;
            }
            System.removeContinuousHandler(global.__krkrns_gfxm_tick);
            // NOTE: the KAG tag trace used to be enabled here with
            // `global.kag.debugLevel = 3`.  In this engine that set throws
            // ("Object kag has no member debugLevel" at this point of the
            // KAG boot), and every throw inside a try block dumps a full VM
            // disassembly to the log - 30 of them per game session.  Enable
            // the trace manually (kag.debugLevel = 3 from a scenario) when it
            // is actually needed.
            try {
                var have = false;
                try { have = global.GenericFlip.Entries["gfxm_file"] !== void; } catch (e) { have = false; }
                if (!have) {
                    Debug.message("[compat] registering .psb motion handler (GFX_Motion.tjs)");
                    global.KAGLoadScript("GFX_Motion.tjs");
                    var ok = false;
                    try { ok = global.GenericFlip.Entries["gfxm_file"] !== void; } catch (e) { ok = false; }
                    Debug.message("[compat] GFX_Motion.tjs registered=" + ok);
                }
            } catch (e) {
                Debug.message("[compat] GFX_Motion.tjs load failed: " + e.message);
            }
        } catch (e) {
            // A handler that throws here has lost the engine it was written
            // for (stale closure after an engine rebuild).  Remove it instead
            // of letting it re-throw every frame.
            try { System.removeContinuousHandler(global.__krkrns_gfxm_tick); } catch (e2) {}
        }
    };
    System.addContinuousHandler(global.__krkrns_gfxm_tick);
}

/* KAGEX scene-animation effects: answer "-scanim" with "no".

   Titles read this switch through System.getArgument and, when it is on, drive
   the title/logo .psb motion through their own MotionController and then block
   in [title_bg waitmovie] until that motion finishes.  This engine cannot start
   that controller, so the wait never ends and the title never paints (black
   screen, no pending damage).  With the switch off the game takes its own
   still-image branch, which renders normally.

   Only this one argument is answered; every other argument goes to the engine. */
