// KRKR-ns launcher. Games live in sdmc:/switch/KRKR-ns/Game/<game directory>/ and are
// treated as read-only. Browsing changes selection only; explicit launch
// mounts the chosen entry plus sibling resource archives.
// Seed the KAG2 compatibility namespace before a game's initialize.tjs runs.
//
// Tested on Krkr2CompatUtils.loadPlugin, NOT on the namespace object itself.
// That distinction is the whole bug: k2compat.tjs creates `Krkr2CompatUtils`
// near its top but only hangs loadPlugin/unloadPlugin/isLoaded/autoLoad off it
// much further down, so the object can exist in a bare state with no members --
// and k2compat.tjs is itself installed only once per process.  Guarding on the
// object therefore skipped the seeding exactly when it was needed, leaving
// KAG's custom.tjs to die in KAGLoadScriptOnce with
// `Member "loadPlugin" does not exist`.
if (typeof(global.Krkr2CompatUtils) == "undefined"
    || typeof(global.Krkr2CompatUtils.loadPlugin) == "undefined") {
    function Krkr2CompatUtils() {}
    global.Krkr2CompatUtils = Krkr2CompatUtils;
    Krkr2CompatUtils.scriptBase = "";
    Krkr2CompatUtils.getMouseCursorPos = function() { return null; };
    Krkr2CompatUtils.getWindowRect = function() { return null; };
    Krkr2CompatUtils.loadPlugin = function(name) { return null; };
    Krkr2CompatUtils.unloadPlugin = function(name) { return null; };
    Krkr2CompatUtils.isLoaded = function(name) { return true; };
    Krkr2CompatUtils.autoLoad = function() { return null; };
    Krkr2CompatUtils.Window = function() { return null; };
    Debug.message("[launcher] compat namespace (re)seeded by launcher script");
}

// Probe: the repair done by SDLApplication.cpp runs just before this script, so
// the namespace here should already carry loadPlugin.  Logging it at this exact
// point separates "the repair did not stick" from "something later in THIS
// script or in the game's boot strips it".
Debug.message("[launcher] probe after guard: loadPlugin="
    + (typeof(Krkr2CompatUtils) == "undefined" ? "NO-NAMESPACE"
       : (typeof(Krkr2CompatUtils.loadPlugin) == "undefined" ? "MISSING" : "ok")));

// Boot phase timing.  The launcher's own script shows up as a multi-second
// "script-load" in the engine log, which is the whole file (window creation,
// the 13 MB font, the library scan and the first paint) -- five very different
// costs hiding behind one number.  These markers split it.
// Local clock, not the nowMs() helper further down: TJS does not hoist
// function declarations, so calling it here would throw before the launcher
// ever painted.
function bootNow() {
    var d = new Date();
    return d.getTime();
}
var bootT0 = bootNow();
function bootMark(label) {
    Debug.message("[boot] " + label + "=" + (bootNow() - bootT0) + "ms");
}

// Native, memory-only library browsing. Game directories are inspected only
// after explicit launch or opening the advanced entry picker.
var launcherWindow = new Window(0, 0, 0, 0);
launcherWindow.caption = "KRKR-ns · 游戏库";
launcherWindow.setInnerSize(1280, 720);
var launcherLayer = new Layer(launcherWindow, null);
launcherWindow.add(launcherLayer);
launcherLayer.setSize(1280, 720);
launcherLayer.type = ltOpaque;
bootMark("window");
var launcherFontFaces = Font.addFont("notosanssc.ttf");
if (launcherFontFaces.count == 0) throw "Unable to load the bundled launcher font";
Font.defaultFaceName = launcherFontFaces[0];
launcherLayer.font.face = launcherFontFaces[0];
bootMark("font");

var C_BG = 0xF6F5F1, C_CARD = 0xFEFDFB, C_FG = 0x302D3C;
var C_MUTED = 0x918B99, C_LINE = 0xE5E1E9;
var C_ACCENT = 0xD9D2F3, C_INK = 0x655185, C_WARN = 0xAD7659;
var GAME_DIR_STORAGE = "sdmc:/switch/KRKR-ns/Game/";
var ALIAS_STORAGE = "sdmc:/switch/KRKR-ns/Names.tjs";
var ENTRY_PREFERENCE = ["启动游戏.xp3", "运行游戏.xp3", "data.xp3", "play.xp3", "main.xp3", "startup.xp3"];
var TONES = [
    %[bg:0xE9E3F2, a:0xD6C6E5, b:0xF6EEDC, ink:0x77638A],
    %[bg:0xE3EBDF, a:0xBDCFB8, b:0xF7E5CF, ink:0x61765F],
    %[bg:0xF2E3D9, a:0xDDBCA9, b:0xF4ECCA, ink:0x967560],
    %[bg:0xDFEAF0, a:0xBACEDB, b:0xF2DDD4, ink:0x607D92],
    %[bg:0xF1ECD7, a:0xD8CB9D, b:0xE1DCEB, ink:0x918253]
];
var INITIAL_POS = [[489,235,0x8B7EAB], [478,233,0x7F9587], [487,235,0xB48B79], [476,232,0x8B82AD], [489,235,0x7C9A8D]];
var games = new Array(), gameAliases = %[];
// Native preferences are read once. Library refresh and selection reuse this
// metadata; original game images are inspected only in the explicit picker.
var artworkChoices = Storages.getGameArtworkChoices();
var artworkScratch = null, uiArtworkLoads = 0;
var selectedFolder = -1, selectedFile = -1, listTop = 0, dialogTop = 0;
var VISIBLE_ROWS = 6, DIALOG_ROWS = 5;
var memoryOk = true, mode = "home", statusText = "";
var launching = false, launchArmed = false, launchPasses = 0;
var launchArmedTick = 0, launchHandler = null;
var uiHandler = null, uiBegan = 0, uiNextTick = 0, uiFromY = 0, uiToY = 0;
var UI_MOTION_MS = 160, UI_FRAME_MS = 16;
var uiLetterX = 784;
var uiMotionLayer = null, uiMotionX = 784;
var widthCache = %[], fitCache = %[], textBuckets = %[], textStyles = new Array();
var paintLayer = launcherLayer;
function isVoid(value) { return typeof value == "void" || typeof value == "undefined"; }
function nowMs() { return System.getTickCount(); }
function paintTo(layer) { flushText(); paintLayer = layer; }
function rect(x, y, w, h, color) {
    if (w > 0 && h > 0) paintLayer.fillRect(Math.round(x), Math.round(y), Math.round(w), Math.round(h), color | 0xff000000);
}
function clearLayer(layer) { layer.fillRect(0, 0, layer.width, layer.height, 0); }
function roundRect(x, y, w, h, r, color) {
    rect(x + r, y, w - r * 2, h, color);
    rect(x, y + r, r, h - r * 2, color);
    rect(x + w - r, y + r, r, h - r * 2, color);
    for (var row = 0; row < r; row++) {
        var d = r - row - 0.5;
        var inset = r - Math.sqrt(r * r - d * d);
        rect(x + inset, y + row, w - inset * 2, 1, color);
        rect(x + inset, y + h - row - 1, w - inset * 2, 1, color);
    }
}
function circle(x, y, radius, color) {
    for (var row = -radius; row < radius; row += 2) {
        var d = row + 0.5;
        var half = Math.sqrt(radius * radius - d * d);
        rect(x - half, y + row, half * 2, 2, color);
    }
}
function spark(x, y, size, color) {
    for (var row = -size; row <= size; row++) {
        var half = (size - Math.abs(row)) * 0.26 + 1;
        rect(x - half, y + row, half * 2, 1, color);
    }
    rect(x - size, y - 1, size * 2, 3, color);
}
function text(x, baseline, label, size, color, bold) {
    var key = size + "|" + (bold ? 1 : 0);
    if (isVoid(textBuckets[key])) { textBuckets[key] = new Array(); textStyles.add(key); }
    textBuckets[key].add(%[x:x, y:baseline - ((size * 880) \ 1000), label:label, size:size, color:color, bold:bold]);
}
function flushText() {
    for (var s = 0; s < textStyles.count; s++) {
        var bucket = textBuckets[textStyles[s]];
        if (bucket.count == 0) continue;
        if (paintLayer.font.height != bucket[0].size) paintLayer.font.height = bucket[0].size;
        if (paintLayer.font.bold != bucket[0].bold) paintLayer.font.bold = bucket[0].bold;
        for (var i = 0; i < bucket.count; i++) {
            var item = bucket[i];
            paintLayer.drawText(item.x, item.y, item.label, item.color);
        }
    }
    textBuckets = %[];
    textStyles = new Array();
}
function widthOf(label, size, bold) {
    var key = size + "|" + (bold ? 1 : 0) + "|" + label;
    if (!isVoid(widthCache[key])) return widthCache[key];
    if (paintLayer.font.height != size) paintLayer.font.height = size;
    if (paintLayer.font.bold != bold) paintLayer.font.bold = bold;
    var width = paintLayer.font.getTextWidth(label);
    widthCache[key] = width;
    return width;
}
function fitText(label, size, bold, width) {
    var key = width + "|" + size + "|" + (bold ? 1 : 0) + "|" + label;
    if (!isVoid(fitCache[key])) return fitCache[key];
    if (widthOf(label, size, bold) <= width) { fitCache[key] = label; return label; }
    var low = 0, high = label.length;
    while (low < high) {
        var middle = (low + high + 1) \ 2;
        if (widthOf(label.substr(0, middle) + "…", size, bold) <= width) low = middle;
        else high = middle - 1;
    }
    var result = label.substr(0, low) + "…";
    fitCache[key] = result;
    return result;
}
function centered(x, baseline, label, size, color, bold) {
    text(x - widthOf(label, size, bold) / 2, baseline, label, size, color, bold);
}
function childLayer(x, y, width, height) {
    var layer = new Layer(launcherWindow, launcherLayer);
    layer.setSize(width, height);
    layer.setPos(x, y);
    layer.type = ltAlpha;
    layer.font.face = launcherFontFaces[0];
    layer.visible = false;
    return layer;
}

// Bundled logo and artwork are loaded once, without probing game folders.
// Wrapped in a function: the surfaces are released right before a game starts
// (the console needs the headroom -- a real console failed to start the
// game's first sound decode thread with only ~15MB free) and rebuilt here if
// the launch fails and the picker stays up.  When a game does start, the
// launcher is rebuilt from scratch on return, so nothing here needs to
// survive it.
var logoLayer = null;
var heroLayers = new Array();
function buildLauncherArt() {
if (logoLayer == null) {
    logoLayer = childLayer(24, 21, 56, 56);
    try { logoLayer.loadImages("launcher/logo-artwork.png"); logoLayer.visible = true; }
    catch (e) { Debug.message("[launcher] bundled logo unavailable: " + e.message); }
}
// Cached native shapes, made once at boot, never loaded from game folders.
heroLayers = new Array();
for (var toneIndex = 0; toneIndex < TONES.count; toneIndex++) {
    var art = childLayer(388, 132, 860, 358);
    paintTo(art);
    clearLayer(art);
    var tone = TONES[toneIndex];
    var embeddedArtReady = false;
    try {
        // These are bundled launcher resources in RomFS, loaded once at boot.
        // Selection only changes the visibility of these cached layers.
        art.loadImages("launcher/hero-" + toneIndex + ".png");
        embeddedArtReady = true;
    } catch (e) {
        Debug.message("[launcher] bundled art unavailable, using native shapes");
    }
    if (!embeddedArtReady) {
    roundRect(0, 0, 860, 358, 30, tone.bg);
    circle(625, 185, 142, tone.a);
    circle(700, 224, 94, tone.b);
    roundRect(546, 73, 136, 190, 16, C_CARD);
    roundRect(558, 73, 124, 190, 16, tone.b);
    rect(564, 99, 92, 2, tone.a);
    rect(564, 105, 62, 2, tone.a);
    roundRect(527, 255, 184, 12, 6, tone.ink);
    circle(746, 99, 21, C_CARD);
    spark(746, 99, 16, tone.ink);
    spark(505, 292, 12, tone.ink);
    spark(791, 266, 10, tone.ink);
    }
    text(25, 34, "已选择", 12, tone.ink, false);
    flushText();
    heroLayers.add(art);
}
}
buildLauncherArt();
// Release every launcher surface that has a lazy rebuild path.  Called right
// before the game's own boot, which is where the memory is needed.
function releaseLauncherArt() {
    if (logoLayer != null) { invalidate logoLayer; logoLayer = null; }
    for (var i = 0; i < heroLayers.count; i++) invalidate heroLayers[i];
    heroLayers = new Array();
    if (games != null) {
        for (var k = 0; k < games.count; k++) {
            var entry = games[k];
            if (entry.previewLayer != null) { invalidate entry.previewLayer; entry.previewLayer = null; }
            if (entry.avatarLayer != null) { invalidate entry.avatarLayer; entry.avatarLayer = null; }
            entry.previewStamp = "";
            entry.avatarStamp = "";
        }
    }
}
var selectionLayer = childLayer(32, 144, 320, 66);
var letterLayer = childLayer(784, 231, 190, 164);
var detailLayer = childLayer(388, 510, 860, 144);
var overlayLayer = childLayer(0, 0, 1280, 720);
// Eight rendered selections plus optional preview images have a fixed bound.
// Default items do not allocate an extra preview or avatar surface. Cache hits
// change layer visibility/position only, so neither fonts nor game files are
// consulted while moving through an already displayed library page.
var UI_CACHE_LIMIT = 8, uiLayerCache = new Array(), uiActiveEntry = null;
var uiCacheClock = 0, uiCachePaints = 0, uiCacheEvictions = 0, uiCacheGeneration = 0;
var activeHeroTone = -1;
var artworkGrid = new Array(), artworkGridKeys = ["", "", "", "", "", ""];
var artworkGridReady = [false, false, false, false, false, false];
var artworkFolder = "", artworkRole = "preview", artworkSourceMode = "game";
var artworkItems = new Array(), artworkScanCache = %[], artworkSelected = -1, artworkPage = 0;
var artworkFocus = "grid", artworkTopFocus = 0, artworkActionFocus = 4;
var artworkStage = "idle", artworkMessage = "", artworkWarnings = false, artworkTruncated = false;
var artworkHandler = null, artworkPasses = 0, artworkArmedTick = 0, artworkCursor = 0, artworkSerial = 0;
var artworkApplyRole = "preview", artworkApplySource = "";
var artworkReturnMode = "home";
paintTo(launcherLayer);
bootMark("art");

function displayNameFor(folder) {
    var alias = gameAliases[folder];
    if (!isVoid(alias) && alias != "") return alias;
    var name = folder;
    var prefix = "【KRKR】";
    if (name.toUpperCase().startsWith(prefix)) name = name.substr(prefix.length);
    if (name.toUpperCase().startsWith("KRKR_")) name = name.substr(5);
    return name;
}
function initialOf(name) {
    var skip = "【】「」『』（）()[]{}<>《》〈〉·・-—_* \u3000";
    for (var i = 0; i < name.length; i++) if (skip.indexOf(name.charAt(i)) < 0) return name.charAt(i);
    return "?";
}
function coverSeed(folder) {
    var alphabet = "0123456789abcdefghijklmnopqrstuvwxyz-_ .";
    var seed = 5381;
    for (var i = 0; i < folder.length; i++) {
        var value = alphabet.indexOf(folder.charAt(i).toLowerCase());
        if (value < 0) value = 37 + i % 11;
        seed = (seed * 131 + value) % 1000003;
    }
    return seed;
}
function buildGame(folder) {
    var name = displayNameFor(folder);
    var choices = artworkChoices[folder];
    var preview = isVoid(choices) || isVoid(choices.preview) ? "" : choices.preview;
    var avatar = isVoid(choices) || isVoid(choices.avatar) ? "" : choices.avatar;
    return %[folder:folder, name:name, initial:initialOf(name), seed:coverSeed(folder), files:null, filesReady:false, entry:-1, preferred:"", previewPath:preview, avatarPath:avatar];
}
function loadAliases() {
    gameAliases = %[];
    try { if (Storages.isExistentStorage(ALIAS_STORAGE)) Scripts.execStorage(ALIAS_STORAGE); }
    catch (e) { Debug.message("[launcher] aliases ignored: " + e.message); }
}
function refreshMemoryState() {
    try { memoryOk = Storages.canLaunchGame(); } catch (e) { memoryOk = true; }
}
function rescanLibrary() {
    var keep = currentGame() != null ? currentGame().folder : "";
    resetUICache();
    widthCache = %[]; fitCache = %[];
    loadAliases();
    var folders = Storages.getGameDirectoryList();
    games = new Array();
    for (var i = 0; i < folders.count; i++) games.add(buildGame(folders[i]));
    selectedFolder = games.count > 0 ? 0 : -1;
    for (var k = 0; k < games.count; k++) if (games[k].folder == keep) selectedFolder = k;
    listTop = 0;
    selectedFile = -1;
    keepSelectionVisible();
    refreshMemoryState();
    statusText = "";
    Debug.message("[launcher] scan: folders=" + games.count + " gameFiles=deferred");
}
function currentGame() { return selectedFolder >= 0 && selectedFolder < games.count ? games[selectedFolder] : null; }
function isXP3(name) { return name.toLowerCase().endsWith(".xp3"); }
function ensureGameFiles(game) {
    if (game == null || game.filesReady) return;
    var files = Storages.getGameFileList(game.folder);
    var preferred = Storages.getPreferredGameEntry(game.folder).toLowerCase();
    var entry = -1;
    for (var i = 0; i < files.count; i++) if (files[i].toLowerCase() == preferred) entry = i;
    if (entry < 0) for (var p = 0; p < ENTRY_PREFERENCE.count && entry < 0; p++) {
        for (var f = 0; f < files.count; f++) if (files[f].toLowerCase() == ENTRY_PREFERENCE[p]) entry = f;
    }
    if (entry < 0) for (var n = 0; n < files.count; n++) if (isXP3(files[n])) { entry = n; break; }
    game.files = files;
    game.entry = entry;
    game.preferred = preferred;
    game.filesReady = true;
    Debug.message("[launcher] inspect on demand: " + game.folder + " files=" + files.count);
}
function loadSelectedFiles() {
    var game = currentGame();
    selectedFile = game != null && game.filesReady ? game.entry : -1;
    dialogTop = 0;
}
function keepSelectionVisible() {
    if (selectedFolder < listTop) listTop = selectedFolder;
    if (selectedFolder >= listTop + VISIBLE_ROWS) listTop = selectedFolder - VISIBLE_ROWS + 1;
    if (listTop > games.count - VISIBLE_ROWS) listTop = games.count - VISIBLE_ROWS;
    if (listTop < 0) listTop = 0;
}
function selectFolder(index) {
    if (games.count == 0) return;
    if (index < 0) index = games.count - 1;
    if (index >= games.count) index = 0;
    selectedFolder = index;
    loadSelectedFiles();
    keepSelectionVisible();
    statusText = "";
}
function keyHint(x, y, key, label) {
    circle(x + 12, y - 5, 12, C_LINE);
    centered(x + 12, y, key, 12, C_FG, true);
    text(x + 33, y, label, 12, C_MUTED, false);
}
function findUICache(folder) {
    for (var i = 0; i < uiLayerCache.count; i++) if (uiLayerCache[i].folder == folder) return uiLayerCache[i];
    return null;
}
function roundImageCorners(layer, width, height, radius) {
    radius = Math.min(radius, Math.floor(Math.min(width, height) / 2));
    for (var row = 0; row < radius; row++) {
        var d = radius - row - 0.5;
        var cut = radius - Math.sqrt(radius * radius - d * d);
        var whole = Math.floor(cut), alpha = Math.round((1 - cut + whole) * 255);
        if (whole > 0) {
            layer.fillRect(0, row, whole, 1, 0);
            layer.fillRect(width - whole, row, whole, 1, 0);
            layer.fillRect(0, height - row - 1, whole, 1, 0);
            layer.fillRect(width - whole, height - row - 1, whole, 1, 0);
        }
        layer.setMaskPixel(whole, row, Math.min(alpha, layer.getMaskPixel(whole, row)));
        layer.setMaskPixel(width - whole - 1, row, Math.min(alpha, layer.getMaskPixel(width - whole - 1, row)));
        layer.setMaskPixel(whole, height - row - 1, Math.min(alpha, layer.getMaskPixel(whole, height - row - 1)));
        layer.setMaskPixel(width - whole - 1, height - row - 1, Math.min(alpha, layer.getMaskPixel(width - whole - 1, height - row - 1)));
    }
}
function loadUIThumbnail(layer, path, width, height, radius) {
    // Only preprocessed launcher-artwork PNGs reach this function. No source
    // archive name or arbitrary game image is passed to the bitmap loader.
    try {
        if (artworkScratch == null) artworkScratch = new Bitmap();
        artworkScratch.load(path);
        var sw = artworkScratch.width, sh = artworkScratch.height, sx = 0, sy = 0;
        if (sw <= 0 || sh <= 0) throw new Exception("图片尺寸无效");
        if (sw * height > sh * width) { var croppedW = sh * width / height; sx = (sw - croppedW) / 2; sw = croppedW; }
        else { var croppedH = sw * height / width; sy = (sh - croppedH) / 2; sh = croppedH; }
        clearLayer(layer);
        layer.stretchCopy(0, 0, width, height, artworkScratch, Math.round(sx), Math.round(sy), Math.max(1, Math.round(sw)), Math.max(1, Math.round(sh)), stLinear);
        artworkScratch.setSize(1, 1);
        roundImageCorners(layer, width, height, radius);
        uiArtworkLoads++;
        return true;
    } catch (e) {
        if (artworkScratch != null) artworkScratch.setSize(1, 1);
        clearLayer(layer);
        Debug.message("[launcher-artwork] cached thumbnail unreadable: " + e.message);
        return false;
    }
}
function prepareCachedArtwork(entry, game) {
    if (entry.avatarStamp != game.avatarPath) {
        entry.avatarLoaded = false;
        if (game.avatarPath != "") {
            if (entry.avatarLayer == null) { entry.avatarLayer = childLayer(0, 0, 44, 44); overlayLayer.bringToFront(); }
            entry.avatarLoaded = loadUIThumbnail(entry.avatarLayer, game.avatarPath, 44, 44, 14);
        } else if (entry.avatarLayer != null) { invalidate entry.avatarLayer; entry.avatarLayer = null; }
        entry.avatarStamp = game.avatarPath;
    }
    if (entry.previewStamp != game.previewPath) {
        entry.previewLoaded = false;
        if (game.previewPath != "") {
            if (entry.previewLayer == null) { entry.previewLayer = childLayer(388, 132, 860, 358); overlayLayer.bringToFront(); }
            entry.previewLoaded = loadUIThumbnail(entry.previewLayer, game.previewPath, 860, 358, 30);
        } else if (entry.previewLayer != null) { invalidate entry.previewLayer; entry.previewLayer = null; }
        entry.previewStamp = game.previewPath;
    }
}
function drawGameAvatar(layer, game, x, y, selected) {
    var tone = TONES[game.seed % TONES.count];
    roundRect(x, y, 44, 44, 14, selected ? C_CARD : tone.bg);
    var entry = findUICache(game.folder);
    if (entry != null && entry.avatarLoaded) layer.pileRect(x, y, entry.avatarLayer, 0, 0, 44, 44, 255);
    else centered(x + 22, y + 30, game.initial, 20, tone.ink, false);
}
function drawRow(layer, game, selected) {
    paintTo(layer);
    var tone = TONES[game.seed % TONES.count];
    if (selected) { clearLayer(layer); roundRect(0, 0, 320, 66, 19, C_ACCENT); }
    drawGameAvatar(layer, game, 14, 11, selected);
    text(72, 32, fitText(game.name, 18, selected, 222), 18, C_FG, selected);
    text(72, 52, "本地游戏", 12, selected ? C_INK : C_MUTED, false);
    if (selected) text(294, 40, "›", 20, C_INK, false);
    flushText();
}
function drawBase() {
    paintTo(launcherLayer);
    rect(0, 0, 1280, 720, C_BG);
    text(86, 56, "KRKR", 25, C_FG, true);
    text(173, 55, "ns", 14, C_INK, false);
    text(216, 55, "游戏库", 13, C_MUTED, false);
    roundRect(1133, 32, 115, 30, 15, C_CARD);
    circle(1150, 47, 3, memoryOk ? 0x92AA86 : C_WARN);
    text(1162, 52, memoryOk ? "准备就绪" : "内存受限", 12, C_MUTED, false);
    text(41, 118, "你的游戏", 14, C_FG, true);
    text(281, 116, "" + games.count + " 部作品", 11, C_MUTED, false);
    for (var i = 0; i < VISIBLE_ROWS && listTop + i < games.count; i++) {
        var game = games[listTop + i];
        var y = 144 + i * 78;
        var tone = TONES[game.seed % TONES.count];
        drawGameAvatar(launcherLayer, game, 46, y + 11, false);
        text(104, y + 32, fitText(game.name, 18, false, 222), 18, C_FG, false);
        text(104, y + 52, "本地游戏", 12, C_MUTED, false);
    }
    text(46, 635, listTop > 0 ? "‹ 上一页" : "", 12, C_MUTED, false);
    text(260, 635, listTop + VISIBLE_ROWS < games.count ? "下一页 ›" : "", 12, C_MUTED, false);
    text(41, 698, "✚", 20, C_MUTED, false);
    text(71, 696, "选择", 12, C_MUTED, false);
    circle(137, 679, 8, C_LINE); centered(137, 682, "X", 8, C_FG, false);
    circle(122, 692, 8, C_LINE); centered(122, 695, "Y", 8, C_FG, false);
    circle(152, 692, 8, C_LINE); centered(152, 695, "A", 8, C_FG, false);
    circle(137, 706, 8, C_LINE); centered(137, 709, "B", 8, C_FG, false);
    keyHint(184, 696, "A", "开始");
    keyHint(260, 696, "B", "返回");
    keyHint(342, 696, "X", "启动选项");
    keyHint(472, 696, "Y", "刷新");
    flushText();
}
function paintCachedLetter(entry, game) {
    paintTo(entry.letter);
    clearLayer(entry.letter);
    var position = INITIAL_POS[game.seed % TONES.count];
    entry.letterX = 388 + position[0] - 95;
    entry.letterY = 132 + position[1] - 136;
    entry.letter.setPos(entry.letterX, entry.letterY);
    centered(95, 136, game.initial, 123, position[2], false);
    flushText();
    uiCachePaints++;
}
function paintCachedDetail(entry, game, index, status) {
    paintTo(entry.detail);
    clearLayer(entry.detail);
    text(0, 22, "" + (index + 1) + " / " + games.count + "    本地游戏", 12, C_MUTED, false);
    text(0, 63, fitText(game.name, 30, true, 780), 30, C_FG, true);
    if (status != "") text(0, 115, fitText(status, 14, false, 550), 14, C_WARN, false);
    roundRect(604, 76, 240, 56, 20, memoryOk ? C_FG : C_LINE);
    text(628, 111, "开始游戏", 18, memoryOk ? C_CARD : C_MUTED, true);
    circle(815, 104, 13, C_CARD);
    centered(815, 109, "A", 12, C_INK, true);
    roundRect(520, 82, 64, 44, 16, C_CARD);
    centered(552, 111, "选项", 14, C_MUTED, false);
    roundRect(436, 82, 74, 44, 16, C_CARD);
    centered(473, 111, "图片", 14, C_MUTED, false);
    flushText();
    uiCachePaints++;
}
function hideUICacheEntry(entry) {
    entry.row.visible = false;
    entry.letter.visible = false;
    entry.detail.visible = false;
    if (entry.previewLayer != null) entry.previewLayer.visible = false;
    if (!isVoid(entry.rowY)) entry.row.top = entry.rowY;
    entry.letter.setPos(entry.letterX, entry.letterY);
    entry.letter.opacity = 255;
}
function resetUICache() {
    stopMotion();
    paintTo(launcherLayer);
    if (uiLayerCache.count > 0) {
        for (var i = 0; i < uiLayerCache.count; i++) {
            var entry = uiLayerCache[i];
            hideUICacheEntry(entry);
            // Explicit invalidation detaches the children and frees pixels;
            // dropping the array alone would leave parent-owned layers alive.
            invalidate entry.row;
            invalidate entry.letter;
            invalidate entry.detail;
            if (entry.avatarLayer != null) invalidate entry.avatarLayer;
            if (entry.previewLayer != null) invalidate entry.previewLayer;
        }
        selectionLayer = childLayer(32, 144, 320, 66);
        letterLayer = childLayer(784, 231, 190, 164);
        detailLayer = childLayer(388, 510, 860, 144);
        overlayLayer.bringToFront();
    }
    uiLayerCache = new Array();
    uiActiveEntry = null;
    uiCacheGeneration++;
    drawnTop = -1; drawnCount = -1;
}
function cachedUIFor(game, index, status) {
    var entry = null;
    for (var i = 0; i < uiLayerCache.count; i++) {
        if (uiLayerCache[i].folder == game.folder) { entry = uiLayerCache[i]; break; }
    }
    if (entry == null) {
        if (uiLayerCache.count < UI_CACHE_LIMIT) {
            if (uiLayerCache.count == 0) {
                entry = %[row:selectionLayer, letter:letterLayer, detail:detailLayer];
            } else {
                entry = %[row:childLayer(32,144,320,66), letter:childLayer(784,231,190,164), detail:childLayer(388,510,860,144)];
                overlayLayer.bringToFront();
            }
            entry.avatarLayer = null; entry.previewLayer = null;
            entry.avatarStamp = "@new"; entry.previewStamp = "@new";
            entry.avatarLoaded = false; entry.previewLoaded = false;
            uiLayerCache.add(entry);
        } else {
            // Reuse the three oldest hidden layers rather than allocating
            // more image memory. The active animated selection is protected.
            for (var victim = 0; victim < uiLayerCache.count; victim++) {
                var candidate = uiLayerCache[victim];
                if (candidate == uiActiveEntry) continue;
                if (entry == null || candidate.used < entry.used) entry = candidate;
            }
            hideUICacheEntry(entry);
            uiCacheEvictions++;
        }
        entry.folder = game.folder;
        entry.rowStamp = ""; entry.letterStamp = ""; entry.detailStamp = "";
        entry.rowY = void;
    }
    entry.used = ++uiCacheClock;
    prepareCachedArtwork(entry, game);
    var commonStamp = game.folder + "|" + game.name + "|" + game.initial + "|" + game.seed;
    var rowStamp = commonStamp + "|" + game.avatarPath;
    if (entry.rowStamp != rowStamp) {
        drawRow(entry.row, game, true);
        uiCachePaints++;
        entry.rowStamp = rowStamp;
    }
    if (entry.letterStamp != commonStamp) { paintCachedLetter(entry, game); entry.letterStamp = commonStamp; }
    var detailStamp = commonStamp + "|" + index + "|" + games.count + "|" + memoryOk + "|" + status;
    if (entry.detailStamp != detailStamp) {
        paintCachedDetail(entry, game, index, status);
        entry.detailStamp = detailStamp;
    }
    return entry;
}
function warmVisibleUICache() {
    for (var i = 0; i < VISIBLE_ROWS && listTop + i < games.count; i++) {
        var index = listTop + i;
        cachedUIFor(games[index], index, index == selectedFolder ? statusText : "");
    }
}
function drawDetail(game) {
    var entry = cachedUIFor(game, selectedFolder, statusText);
    if (uiActiveEntry != entry) {
        if (uiActiveEntry != null) hideUICacheEntry(uiActiveEntry);
        uiActiveEntry = entry;
        selectionLayer = entry.row;
        letterLayer = entry.letter;
        detailLayer = entry.detail;
    }
    var heroTone = entry.previewLoaded ? -2 : game.seed % TONES.count;
    if (activeHeroTone != heroTone) {
        for (var i = 0; i < heroLayers.count; i++) heroLayers[i].visible = i == heroTone;
        activeHeroTone = heroTone;
    }
    uiLetterX = entry.letterX;
    letterLayer.setPos(entry.letterX, entry.letterY);
    letterLayer.opacity = 255;
    letterLayer.visible = !entry.previewLoaded;
    if (entry.previewLayer != null) {
        entry.previewLayer.setPos(388, 132);
        entry.previewLayer.opacity = 255;
        entry.previewLayer.visible = entry.previewLoaded;
    }
    detailLayer.visible = true;
}
function drawEmpty() {
    drawBase();
    for (var i = 0; i < heroLayers.count; i++) heroLayers[i].visible = false;
    activeHeroTone = -1;
    selectionLayer.visible = false;
    letterLayer.visible = false;
    detailLayer.visible = false;
    paintTo(launcherLayer);
    roundRect(388, 132, 860, 458, 30, C_CARD);
    circle(818, 264, 52, C_ACCENT);
    spark(818, 264, 28, C_INK);
    centered(818, 376, "暂无游戏", 26, C_FG, true);
    centered(818, 417, "将游戏文件夹放入 SD:/switch/KRKR-ns/Game/", 14, C_MUTED, false);
    roundRect(711, 462, 214, 52, 18, C_ACCENT);
    centered(818, 495, "刷新游戏库  Y", 16, C_FG, true);
    flushText();
}
function stopMotion() {
    if (uiHandler != null) { System.removeContinuousHandler(uiHandler); uiHandler = null; }
    if (uiMotionLayer != null) { uiMotionLayer.left = uiMotionX; uiMotionLayer.opacity = 255; uiMotionLayer = null; }
    selectionLayer.top = uiToY;
    letterLayer.left = uiLetterX;
    letterLayer.opacity = 255;
}
function motionTick(tick) {
    var age = Math.max(0, tick - uiBegan);
    if (tick < uiNextTick && age < UI_MOTION_MS) return;
    // Anchor the deadline to the start, so 60 Hz callback jitter cannot
    // repeatedly skip every other frame. Interpolate from actual elapsed time.
    uiNextTick = uiBegan + ((age \ UI_FRAME_MS) + 1) * UI_FRAME_MS;
    var t = Math.min(1, age / UI_MOTION_MS);
    var eased = 1 - (1 - t) * (1 - t);
    selectionLayer.top = Math.round(uiFromY + (uiToY - uiFromY) * eased);
    if (uiMotionLayer != null) {
        uiMotionLayer.left = uiMotionX + Math.round(12 * (1 - eased));
        uiMotionLayer.opacity = Math.round(190 + 65 * eased);
    }
    if (t >= 1) stopMotion();
}
function startMotion(oldY) {
    uiFromY = oldY;
    uiToY = 144 + (selectedFolder - listTop) * 78;
    uiBegan = nowMs(); uiNextTick = uiBegan + UI_FRAME_MS;
    selectionLayer.top = oldY;
    uiMotionLayer = uiActiveEntry != null && uiActiveEntry.previewLoaded ? uiActiveEntry.previewLayer : letterLayer;
    uiMotionX = uiActiveEntry != null && uiActiveEntry.previewLoaded ? 388 : uiLetterX;
    uiMotionLayer.left = uiMotionX + 12;
    uiMotionLayer.opacity = 190;
    if (uiHandler == null) { uiHandler = function(tick) { motionTick(tick); }; System.addContinuousHandler(uiHandler); }
}
var drawnTop = -1, drawnCount = -1, drawnMemory = memoryOk;
function redraw() {
    if (games.count == 0) drawEmpty();
    else {
        var pageChanged = drawnTop != listTop || drawnCount != games.count || drawnMemory != memoryOk;
        if (pageChanged) { warmVisibleUICache(); drawBase(); drawnTop = listTop; drawnCount = games.count; drawnMemory = memoryOk; }
        var game = currentGame();
        drawDetail(game);
        selectionLayer.visible = true;
        uiToY = 144 + (selectedFolder - listTop) * 78;
        uiActiveEntry.rowY = uiToY;
        selectionLayer.top = uiToY;
    }
    overlayLayer.visible = false;
    if (launching) drawLaunching();
    else if (mode == "entry") drawEntryDialog();
    else if (mode == "artwork") drawArtworkDialog();
    else if (mode == "exit") drawExitConfirm();
}
function modalStart(x, y, w, h) {
    stopMotion();
    paintTo(overlayLayer); clearLayer(overlayLayer);
    overlayLayer.fillRect(0, 0, 1280, 720, 0x90302D3C);
    roundRect(x, y + 5, w, h, 26, 0xD1C9DA);
    roundRect(x, y, w, h, 26, C_CARD);
    overlayLayer.visible = true;
}
function keepDialogVisible() {
    if (selectedFile < dialogTop) dialogTop = selectedFile;
    if (selectedFile >= dialogTop + DIALOG_ROWS) dialogTop = selectedFile - DIALOG_ROWS + 1;
    if (dialogTop < 0) dialogTop = 0;
}
function drawEntryDialog() {
    modalStart(360, 128, 560, 464);
    text(392, 179, "启动选项", 24, C_FG, true);
    roundRect(666, 149, 172, 34, 12, C_ACCENT);
    centered(752, 172, "游戏图片  ›", 13, C_FG, false);
    text(870, 174, "×", 24, C_MUTED, false);
    text(392, 217, "通常直接开始即可；仅在需要时更换启动文件。", 13, C_MUTED, false);
    var game = currentGame();
    var count = game != null && game.filesReady ? game.files.count : 0;
    for (var i = 0; i < DIALOG_ROWS && dialogTop + i < count; i++) {
        var index = dialogTop + i, y = 248 + i * 48;
        if (index == selectedFile) roundRect(384, y, 512, 42, 12, C_ACCENT);
        text(402, y + 28, fitText(game.files[index], 16, index == selectedFile, 420), 16, C_FG, index == selectedFile);
        if (index == selectedFile) text(859, y + 28, "✓", 16, C_INK, true);
    }
    if (count == 0) text(402, 294, "未找到可用的启动文件", 16, C_MUTED, false);
    text(392, 521, "↑↓ 选择文件  ·  → 图片  ·  A 确认  ·  B 返回", 13, C_MUTED, false);
    roundRect(720, 542, 176, 34, 12, C_ACCENT);
    centered(808, 565, "完成  A", 14, C_FG, true);
    flushText();
}
function artworkRoleName() { return artworkRole == "preview" ? "预览图" : "头像"; }
function artworkPageCount() { return (artworkItems.count + 5) \ 6; }
function artworkFailureLabel(message) {
    if (message.indexOf("Artwork format is unreadable") >= 0) return "需专用解码";
    if (message.indexOf("exceeds") >= 0) return "图片过大";
    return "读取失败";
}
function artworkTileX(slot) { return 256 + (slot % 3) * 256; }
function artworkTileY(slot) { return 224 + (slot \ 3) * 164; }
function ensureArtworkGrid() {
    if (artworkGrid.count != 0) return;
    for (var i = 0; i < 6; i++) {
        var layer = new Layer(launcherWindow, overlayLayer);
        layer.setSize(220, 108); layer.type = ltAlpha; layer.visible = false;
        artworkGrid.add(layer);
    }
}
function hideArtworkGrid() { for (var i = 0; i < artworkGrid.count; i++) artworkGrid[i].visible = false; }
function cancelArtworkWork() {
    if (artworkHandler != null) { System.removeContinuousHandler(artworkHandler); artworkHandler = null; }
    artworkStage = "idle";
}
function closeArtwork() {
    artworkSerial++;
    cancelArtworkWork(); hideArtworkGrid();
    artworkItems = new Array(); artworkScanCache = %[];
    mode = artworkReturnMode; overlayLayer.visible = false; redraw();
}
function queueArtworkWork(stage) {
    cancelArtworkWork();
    artworkStage = stage; artworkPasses = 0;
    artworkHandler = function(tick) { artworkTick(tick); };
    System.addContinuousHandler(artworkHandler);
}
function drawArtworkTile(slot) {
    var index = artworkPage * 6 + slot;
    var x = artworkTileX(slot), y = artworkTileY(slot);
    var highlighted = artworkFocus == "grid" && index == artworkSelected;
    roundRect(x, y, 236, 146, 14, highlighted ? C_ACCENT : C_LINE);
    roundRect(x + 8, y + 8, 220, 108, 10, C_CARD);
    if (index < artworkItems.count) {
        text(x + 10, y + 135, fitText(artworkItems[index].name, 12, false, 214), 12, C_FG, false);
        if (artworkGridKeys[slot] == artworkItems[index].source && !artworkGridReady[slot])
            text(x + 16, y + 70, artworkItems[index].gridError == "" ? "读取失败" : artworkItems[index].gridError, 12, C_MUTED, false);
    }
}
function drawArtworkSelection() {
    paintTo(overlayLayer);
    for (var i = 0; i < 6 && artworkPage * 6 + i < artworkItems.count; i++) drawArtworkTile(i);
    flushText();
}
function artworkButton(x, y, width, label, selected) {
    roundRect(x, y, width, 34, 12, selected ? C_ACCENT : C_LINE);
    centered(x + width / 2, y + 23, label, 13, C_FG, false);
}
function drawArtworkDialog() {
    ensureArtworkGrid();
    modalStart(224, 78, 832, 580);
    text(256, 124, "游戏图片", 24, C_FG, true);
    text(1009, 121, "×", 23, C_MUTED, false);
    artworkButton(256, 144, 164, "预览图", artworkRole == "preview" || (artworkFocus == "top" && artworkTopFocus == 0));
    artworkButton(432, 144, 164, "头像", artworkRole == "avatar" || (artworkFocus == "top" && artworkTopFocus == 1));
    artworkButton(724, 144, 142, "游戏 CG", artworkSourceMode == "game" || (artworkFocus == "top" && artworkTopFocus == 2));
    artworkButton(878, 144, 146, "自定义", artworkSourceMode == "custom" || (artworkFocus == "top" && artworkTopFocus == 3));
    var status = artworkMessage;
    if (status == "") {
        status = artworkItems.count > 0 ? "找到 " + artworkItems.count + " 张图片，选择后可用作" + artworkRoleName() + "。" : "未找到可用图片。";
        if (artworkWarnings) status += " 不可用的图片可改用自定义图片。";
        if (artworkTruncated) status += " 已显示可浏览的图片。";
    }
    text(256, 207, fitText(status, 13, false, 764), 13, C_MUTED, false);
    if (artworkStage == "scan") {
        hideArtworkGrid();
        centered(640, 354, artworkSourceMode == "custom" ? "正在读取自定义图片…" : "正在寻找游戏图片…", 22, C_FG, true);
        centered(640, 397, "B 返回", 13, C_MUTED, false);
    } else if (artworkItems.count == 0) {
        hideArtworkGrid();
        centered(640, 342, "暂无可用图片", 22, C_FG, true);
        centered(640, 385, artworkSourceMode == "custom" ? "将 PNG/JPG 图片放入 SD:/switch/KRKR-ns/Artwork/" : "可切换到自定义图片，或选择重新扫描。", 13, C_MUTED, false);
    } else {
        for (var i = 0; i < 6; i++) {
            drawArtworkTile(i);
            var key = artworkPage * 6 + i < artworkItems.count ? artworkItems[artworkPage * 6 + i].source : "";
            artworkGrid[i].setPos(artworkTileX(i) + 8, artworkTileY(i) + 8);
            artworkGrid[i].visible = key != "" && artworkGridKeys[i] == key && artworkGridReady[i];
        }
    }
    artworkButton(256, 568, 142, "恢复默认", artworkFocus == "actions" && artworkActionFocus == 0);
    artworkButton(410, 568, 142, "重新扫描", artworkFocus == "actions" && artworkActionFocus == 1);
    artworkButton(696, 568, 50, "‹", artworkFocus == "actions" && artworkActionFocus == 2);
    artworkButton(756, 568, 50, "›", artworkFocus == "actions" && artworkActionFocus == 3);
    artworkButton(838, 568, 186, artworkStage == "apply" ? "正在设置…" : "用作" + artworkRoleName() + "  A", artworkFocus == "actions" && artworkActionFocus == 4);
    text(256, 631, "↑↓←→ 选择 · A 应用 · B 返回 · X 用途 · Y 来源 · L/R 翻页", 12, C_MUTED, false);
    if (artworkItems.count > 0) text(857, 631, "" + (artworkPage + 1) + " / " + artworkPageCount(), 12, C_MUTED, false);
    flushText();
}
function startArtworkGridPage() {
    ensureArtworkGrid();
    artworkCursor = 0;
    for (var i = 0; i < 6; i++) {
        var index = artworkPage * 6 + i;
        var key = index < artworkItems.count ? artworkItems[index].source : "";
        if (artworkGridKeys[i] != key) { artworkGrid[i].visible = false; artworkGridKeys[i] = ""; artworkGridReady[i] = false; clearLayer(artworkGrid[i]); }
    }
    queueArtworkWork("grid");
    drawArtworkDialog();
}
function useArtworkResult(result) {
    artworkItems = result.items;
    // Cache generated paths, not extra pixel layers, for the whole scan. A
    // returning page reads only its owned PNGs rather than decoding game CG.
    for (var i = 0; i < artworkItems.count; i++) {
        var item = artworkItems[i];
        if (isVoid(item.gridAttempted)) {
            item.gridPath = ""; item.gridAttempted = false; item.gridFailed = false; item.gridError = "";
        }
    }
    artworkWarnings = result.warnings.count > 0;
    artworkTruncated = result.truncated;
    artworkSelected = artworkItems.count > 0 ? 0 : -1; artworkPage = 0;
    artworkFocus = artworkItems.count > 0 ? "grid" : "top";
    artworkMessage = "";
    startArtworkGridPage();
}
function chooseArtworkSource(source, force) {
    artworkSerial++; cancelArtworkWork();
    artworkSourceMode = source; artworkSelected = -1; artworkPage = 0;
    artworkItems = new Array(); hideArtworkGrid();
    if (!force && !isVoid(artworkScanCache[source])) { useArtworkResult(artworkScanCache[source]); return; }
    if (force) artworkScanCache[source] = void;
    // A fresh scan also retries candidates which previously failed decoding.
    for (var i = 0; i < 6; i++) { artworkGridKeys[i] = ""; artworkGridReady[i] = false; }
    artworkMessage = source == "custom" ? "正在读取自定义图片…" : "正在寻找游戏 CG…";
    queueArtworkWork("scan"); drawArtworkDialog();
}
function openArtwork() {
    var game = currentGame(); if (game == null) return;
    artworkReturnMode = mode == "entry" ? "entry" : "home";
    stopMotion(); artworkFolder = game.folder;
    artworkRole = "preview"; artworkScanCache = %[]; artworkFocus = "grid";
    mode = "artwork";
    chooseArtworkSource("game", false);
}
function persistArtworkChoice(path, role) {
    if (!Storages.setGameArtworkChoice(artworkFolder, role, path)) throw new Exception("未能保存图片设置");
    var choices = artworkChoices[artworkFolder];
    if (isVoid(choices)) { choices = %[preview:"", avatar:""]; artworkChoices[artworkFolder] = choices; }
    choices[role] = path;
    var game = currentGame();
    if (game != null && game.folder == artworkFolder) {
        if (role == "avatar") { game.avatarPath = path; drawnTop = -1; }
        else game.previewPath = path;
    }
}
function applyArtwork() {
    if (artworkStage == "scan" || artworkStage == "apply" || artworkSelected < 0 || artworkSelected >= artworkItems.count) return;
    var item = artworkItems[artworkSelected];
    if (item.gridFailed) {
        artworkMessage = item.gridError == "需专用解码" ? "此图片需要专用解码，请使用自定义图片。" : "此图片暂不可用，请换一张或重新扫描。";
        drawArtworkDialog(); return;
    }
    artworkApplySource = artworkItems[artworkSelected].source;
    artworkApplyRole = artworkRole;
    artworkMessage = "正在设置" + artworkRoleName() + "…";
    queueArtworkWork("apply"); drawArtworkDialog();
}
function resetArtworkChoice() {
    if (artworkStage == "apply") return;
    try {
        persistArtworkChoice("", artworkRole);
        artworkMessage = "已恢复默认" + artworkRoleName() + "。";
        redraw();
    } catch (e) { artworkMessage = "设置失败，请重试。"; Debug.message("[launcher-artwork] reset failed: " + e.message); drawArtworkDialog(); }
}
function artworkTick(tick) {
    if (mode != "artwork") { cancelArtworkWork(); return; }
    if (artworkPasses == 0) { artworkPasses = 1; artworkArmedTick = tick; return; }
    if (tick - artworkArmedTick < 16) return;
    var serial = artworkSerial;
    if (artworkStage == "scan") {
        try {
            var result = Storages.scanGameArtwork(artworkFolder, artworkSourceMode);
            if (serial != artworkSerial || mode != "artwork") return;
            artworkScanCache[artworkSourceMode] = result;
            useArtworkResult(result);
        } catch (e) {
            cancelArtworkWork(); artworkItems = new Array(); artworkMessage = "无法读取，请重试或使用自定义图片。";
            Debug.message("[launcher-artwork] scan failed: " + e.message); drawArtworkDialog();
        }
        return;
    }
    if (artworkStage == "apply") {
        try {
            var path = Storages.makeGameArtworkThumbnail(artworkFolder, artworkApplySource, artworkApplyRole);
            if (path == "") throw new Exception("图片缩略图为空");
            if (serial != artworkSerial || mode != "artwork") return;
            persistArtworkChoice(path, artworkApplyRole);
            cancelArtworkWork(); artworkMessage = "已设置" + (artworkApplyRole == "preview" ? "预览图" : "头像") + "。";
            redraw();
            queueArtworkWork("grid");
        } catch (e) {
            cancelArtworkWork(); artworkMessage = "无法读取，请换一张或使用自定义图片。";
            Debug.message("[launcher-artwork] apply failed source=" + artworkApplySource + ": " + e.message); drawArtworkDialog();
        }
        return;
    }
    if (artworkStage == "grid") {
        // One thumbnail per callback. Cancellation is observed between each
        // decode rather than holding the input loop for all six images.
        while (artworkCursor < 6) {
            var slot = artworkCursor++, index = artworkPage * 6 + slot;
            if (index >= artworkItems.count) continue;
            var item = artworkItems[index], source = item.source;
            if (artworkGridKeys[slot] == source) continue;
            try {
                if (!item.gridAttempted) {
                    item.gridAttempted = true;
                    item.gridPath = Storages.makeGameArtworkThumbnail(artworkFolder, source, "grid");
                    if (item.gridPath == "") throw new Exception("图片缩略图为空");
                }
                if (serial != artworkSerial || mode != "artwork") return;
                var loaded = !item.gridFailed && loadUIThumbnail(artworkGrid[slot], item.gridPath, 220, 108, 10);
                artworkGridKeys[slot] = source;
                artworkGridReady[slot] = loaded;
                artworkGrid[slot].visible = loaded;
                if (!loaded) {
                    item.gridFailed = true; item.gridError = "缓存读取失败"; artworkWarnings = true;
                    paintTo(overlayLayer); drawArtworkTile(slot); flushText();
                }
            } catch (e) {
                item.gridFailed = true; item.gridError = artworkFailureLabel(e.message);
                artworkGridKeys[slot] = source; artworkGridReady[slot] = false; artworkGrid[slot].visible = false;
                artworkWarnings = true;
                Debug.message("[launcher-artwork] grid image skipped source=" + source + ": " + e.message);
                paintTo(overlayLayer); drawArtworkTile(slot); flushText();
            }
            return;
        }
        cancelArtworkWork();
    }
}
function moveArtworkSelection(delta) {
    if (artworkItems.count == 0) return;
    var oldPage = artworkPage;
    artworkSelected += delta;
    if (artworkSelected < 0) artworkSelected = 0;
    if (artworkSelected >= artworkItems.count) artworkSelected = artworkItems.count - 1;
    artworkPage = artworkSelected \ 6;
    artworkFocus = "grid";
    if (oldPage != artworkPage) startArtworkGridPage(); else drawArtworkSelection();
}
function setArtworkRole(role) {
    artworkRole = role;
    if (artworkStage != "scan" && artworkStage != "apply") artworkMessage = "";
    drawArtworkDialog();
}
function pageArtwork(delta, fromEdge) {
    if (artworkItems.count == 0) return;
    var page = artworkPage + delta;
    if (page < 0) page = 0;
    if (page >= artworkPageCount()) page = artworkPageCount() - 1;
    if (page == artworkPage) return;
    var slot = artworkSelected - artworkPage * 6;
    if (fromEdge) slot = (slot \ 3) * 3 + (delta > 0 ? 0 : 2);
    artworkSelected = page * 6 + slot;
    if (artworkSelected >= artworkItems.count) artworkSelected = artworkItems.count - 1;
    artworkPage = page; artworkFocus = "grid";
    startArtworkGridPage();
}
function artworkTopAction() {
    if (artworkTopFocus == 0) setArtworkRole("preview");
    else if (artworkTopFocus == 1) setArtworkRole("avatar");
    else chooseArtworkSource(artworkTopFocus == 2 ? "game" : "custom", false);
}
function artworkAction() {
    if (artworkActionFocus == 0) resetArtworkChoice();
    else if (artworkActionFocus == 1) chooseArtworkSource(artworkSourceMode, true);
    else if (artworkActionFocus == 2) pageArtwork(-1, false);
    else if (artworkActionFocus == 3) pageArtwork(1, false);
    else applyArtwork();
}
function artworkKey(key, confirm, back) {
    if (back) { closeArtwork(); return; }
    if (artworkStage == "apply") return;
    if (key == 0x1C2) { setArtworkRole(artworkRole == "preview" ? "avatar" : "preview"); return; }
    if (key == 0x1C3) { chooseArtworkSource(artworkSourceMode == "game" ? "custom" : "game", false); return; }
    if (key == 0x1C4 || key == 0x1C5) { pageArtwork(key == 0x1C4 ? -1 : 1, false); return; }
    var up = key == 0x26 || key == 0x1B6, down = key == 0x28 || key == 0x1B8;
    var left = key == 0x25 || key == 0x1B5, right = key == 0x27 || key == 0x1B7;
    if (artworkFocus == "top") {
        if (left) artworkTopFocus = Math.max(0, artworkTopFocus - 1);
        else if (right) artworkTopFocus = Math.min(3, artworkTopFocus + 1);
        else if (down) artworkFocus = artworkItems.count > 0 ? "grid" : "actions";
        else if (confirm) { artworkTopAction(); return; }
        drawArtworkDialog(); return;
    }
    if (artworkFocus == "actions") {
        if (left) artworkActionFocus = Math.max(0, artworkActionFocus - 1);
        else if (right) artworkActionFocus = Math.min(4, artworkActionFocus + 1);
        else if (up) artworkFocus = artworkItems.count > 0 ? "grid" : "top";
        else if (confirm) { artworkAction(); return; }
        drawArtworkDialog(); return;
    }
    if (confirm) { applyArtwork(); return; }
    if (up && artworkSelected - artworkPage * 6 < 3) { artworkFocus = "top"; artworkTopFocus = artworkRole == "preview" ? 0 : 1; drawArtworkDialog(); }
    else if (down && (artworkSelected - artworkPage * 6 >= 3 || artworkSelected + 3 >= artworkItems.count)) { artworkFocus = "actions"; artworkActionFocus = 4; drawArtworkDialog(); }
    else if (up) moveArtworkSelection(-3);
    else if (down) moveArtworkSelection(3);
    else if (left) { if ((artworkSelected - artworkPage * 6) % 3 == 0) pageArtwork(-1, true); else moveArtworkSelection(-1); }
    else if (right) { if ((artworkSelected - artworkPage * 6) % 3 == 2) pageArtwork(1, true); else moveArtworkSelection(1); }
}
function artworkMouse(x, y) {
    if (x >= 988 && x < 1040 && y >= 92 && y < 134) { closeArtwork(); return; }
    if (artworkStage == "apply") return;
    if (y >= 144 && y < 178) {
        if (x >= 256 && x < 420) setArtworkRole("preview");
        else if (x >= 432 && x < 596) setArtworkRole("avatar");
        else if (x >= 724 && x < 866) chooseArtworkSource("game", false);
        else if (x >= 878 && x < 1024) chooseArtworkSource("custom", false);
        return;
    }
    for (var i = 0; i < 6; i++) {
        var tx = artworkTileX(i), ty = artworkTileY(i), index = artworkPage * 6 + i;
        if (x >= tx && x < tx + 236 && y >= ty && y < ty + 146 && index < artworkItems.count) { artworkSelected = index; artworkFocus = "grid"; drawArtworkSelection(); return; }
    }
    if (y >= 568 && y < 602) {
        if (x >= 256 && x < 398) resetArtworkChoice();
        else if (x >= 410 && x < 552) chooseArtworkSource(artworkSourceMode, true);
        else if (x >= 696 && x < 746) pageArtwork(-1, false);
        else if (x >= 756 && x < 806) pageArtwork(1, false);
        else if (x >= 838 && x < 1024) applyArtwork();
    }
}
function drawExitConfirm() {
    modalStart(420, 240, 440, 240);
    text(452, 292, "退出启动器？", 24, C_FG, true);
    text(452, 330, "退出启动器，回到 HBMenu。", 14, C_MUTED, false);
    roundRect(452, 392, 170, 48, 16, C_ACCENT);
    roundRect(642, 392, 186, 48, 16, C_LINE);
    centered(537, 424, "退出  A", 16, C_FG, true);
    centered(735, 424, "取消  B", 16, C_FG, false);
    flushText();
}
function drawLaunching() {
    var game = currentGame();
    modalStart(380, 238, 520, 244);
    circle(430, 298, 22, C_ACCENT);
    spark(430, 298, 13, C_INK);
    text(470, 307, "正在启动", 24, C_FG, true);
    text(412, 365, game != null ? fitText(game.name, 20, true, 454) : "", 20, C_FG, true);
    text(412, 405, "正在打开游戏，请稍候。", 14, C_MUTED, false);
    flushText();
}
function performLaunch() {
    var game = currentGame();
    try {
        ensureGameFiles(game);
        if (game == null || game.entry < 0 || !isXP3(game.files[game.entry])) {
            launching = false;
            statusText = "未找到可启动的游戏包，请检查启动选项。";
            redraw(); return;
        }
        selectedFile = game.entry;
        Debug.message("[launcher] launch: " + game.folder + "/" + game.files[selectedFile]);
        // The game needs the memory these surfaces hold (see releaseLauncherArt).
        releaseLauncherArt();
        if (!Storages.launchXP3(game.folder, game.files[selectedFile], launcherWindow)) {
            launching = false; memoryOk = false;
            buildLauncherArt();
            statusText = "请按住 R 从游戏进入 HBMenu，再打开启动器。";
            drawnTop = -1; redraw();
        }
    } catch (e) {
        launching = false;
        buildLauncherArt();
        statusText = "启动失败：" + e.message;
        Debug.message("[launcher] failed: " + e.message);
        redraw();
    }
}
function launcherTick(tick) {
    if (!launchArmed) return;
    if (launchPasses == 0) { launchPasses = 1; launchArmedTick = tick; return; }
    if (tick - launchArmedTick < 16) return;
    launchArmed = false;
    if (launchHandler != null) { System.removeContinuousHandler(launchHandler); launchHandler = null; }
    stopMotion();
    performLaunch();
}
function requestLaunch() {
    if (launching || currentGame() == null) return;
    refreshMemoryState();
    if (!memoryOk) { statusText = "请使用完整内存模式进入 HBMenu。"; drawnTop = -1; redraw(); return; }
    stopMotion();
    launching = true; launchArmed = true; launchPasses = 0;
    if (launchHandler == null) { launchHandler = function(tick) { launcherTick(tick); }; System.addContinuousHandler(launchHandler); }
    redraw();
}
function rescanLibraryAndRedraw() {
    stopMotion(); rescanLibrary(); drawnTop = -1; redraw();
}
function closeDialog(confirm) {
    var game = currentGame();
    if (mode == "entry" && game != null) {
        if (confirm && selectedFile >= 0) game.entry = selectedFile;
        else selectedFile = game.entry;
    }
    mode = "home";
    overlayLayer.visible = false;
}
function runAction(action) {
    if (launching) return;
    if (action == "launch") requestLaunch();
    else if (action == "artwork") openArtwork();
    else if (action == "entry" && currentGame() != null) {
        try { ensureGameFiles(currentGame()); loadSelectedFiles(); mode = "entry"; keepDialogVisible(); drawEntryDialog(); }
        catch (e) { statusText = "无法读取启动选项：" + e.message; redraw(); }
    } else if (action == "rescan") rescanLibraryAndRedraw();
    else if (action == "exit") { mode = "exit"; drawExitConfirm(); }
    else if (action == "doExit") System.exit(0);
    else if (action == "dialogClose") closeDialog();
}
function moveRail(delta) {
    if (games.count == 0) return;
    var oldY = selectionLayer.top, oldTop = listTop;
    stopMotion(); selectFolder(selectedFolder + delta); redraw();
    if (oldTop == listTop) startMotion(oldY);
}
function pageRail(delta) {
    if (games.count == 0) return;
    var index = selectedFolder + delta * VISIBLE_ROWS;
    if (index < 0) index = 0;
    if (index >= games.count) index = games.count - 1;
    stopMotion(); selectFolder(index); redraw();
}
function moveEntry(delta) {
    var game = currentGame();
    if (game == null || game.files.count == 0) return;
    selectedFile += delta;
    if (selectedFile < 0) selectedFile = game.files.count - 1;
    if (selectedFile >= game.files.count) selectedFile = 0;
    keepDialogVisible(); drawEntryDialog();
}
launcherWindow.onMouseDown = function(x, y, button, shift) {
    if (launching) return;
    if (mode == "artwork") { artworkMouse(x, y); return; }
    if (mode == "entry") {
        if (x >= 666 && x < 838 && y >= 149 && y < 183) { openArtwork(); return; }
        if (x >= 384 && x < 896 && y >= 248 && y < 488) {
            var index = dialogTop + ((y - 248) \ 48);
            if (index < currentGame().files.count) { selectedFile = index; closeDialog(true); }
        } else if (x >= 720 && x < 896 && y >= 542 && y < 576) closeDialog(true);
        else if (x >= 854 && x < 906 && y >= 142 && y < 188) closeDialog();
        else if (x < 360 || x >= 920 || y < 128 || y >= 592) closeDialog();
        return;
    }
    if (mode == "exit") {
        if (x >= 452 && x < 622 && y >= 392 && y < 440) System.exit(0);
        else if (x >= 642 && x < 828 && y >= 392 && y < 440) closeDialog();
        return;
    }
    if (y >= 674) {
        if (x >= 184 && x < 252) runAction("launch");
        else if (x >= 260 && x < 334) runAction("exit");
        else if (x >= 342 && x < 462) runAction("entry");
        else if (x >= 472 && x < 576) runAction("rescan");
        return;
    }
    if (games.count == 0) { if (x >= 711 && x < 925 && y >= 462 && y < 514) runAction("rescan"); return; }
    if (x >= 32 && x < 352 && y >= 144 && y < 612) {
        var index = listTop + ((y - 144) \ 78);
        if (index < games.count && index != selectedFolder) {
            var oldY = selectionLayer.top; stopMotion(); selectFolder(index); redraw(); startMotion(oldY);
        }
    } else if (x >= 992 && x < 1232 && y >= 586 && y < 642) runAction("launch");
    else if (x >= 824 && x < 898 && y >= 592 && y < 636) runAction("artwork");
    else if (x >= 908 && x < 972 && y >= 592 && y < 636) runAction("entry");
    else if (x >= 32 && x < 174 && y >= 616 && y < 652) pageRail(-1);
    else if (x >= 240 && x < 352 && y >= 616 && y < 652) pageRail(1);
};
launcherWindow.onKeyDown = function(key, shift) {
    if (launching) return;
    // Switch: physical A=PAD1, B=PAD2, X=PAD3, Y=PAD4.
    var confirm = key == 0x1C0 || key == 0x0D || key == 0x20;
    var back = key == 0x1C1 || key == 0x1B;
    if (mode == "artwork") { artworkKey(key, confirm, back); return; }
    if (mode == "entry") {
        if (key == 0x27 || key == 0x1B7) openArtwork();
        else if (key == 0x26 || key == 0x1B6) moveEntry(-1);
        else if (key == 0x28 || key == 0x1B8) moveEntry(1);
        else if (confirm) closeDialog(true);
        else if (back) closeDialog(false);
        return;
    }
    if (mode == "exit") { if (confirm) System.exit(0); else if (back) closeDialog(); return; }
    if (key == 0x26 || key == 0x1B6) moveRail(-1);
    else if (key == 0x28 || key == 0x1B8) moveRail(1);
    else if (key == 0x25 || key == 0x1B5) pageRail(-1);
    else if (key == 0x27 || key == 0x1B7) pageRail(1);
    else if (key == 0x1C2) runAction("entry");
    else if (key == 0x1C3) runAction("rescan");
    else if (back) runAction("exit");
    else if (confirm) runAction("launch");
};
launcherWindow.onMouseWheel = function(shift, delta, x, y) { if (!launching && mode == "home") moveRail(delta > 0 ? -1 : 1); };
rescanLibrary();
bootMark("scan");
redraw();
bootMark("firstpaint");
launcherWindow.visible = true;
Debug.message("[launcher] ready, folders=" + games.count + " gameFiles=deferred; A=confirm B=back X=options Y=refresh");
if (Storages.isExistentStorage("sdmc:/switch/KRKR-ns/autocycle.txt") && games.count > 0) {
    selectFolder(Storages.getAutocycleRound() % games.count);
    requestLaunch();
}
