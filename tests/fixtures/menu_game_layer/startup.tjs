// The released MenuItem capability must select KAG's derived MenuItem branch.
// Later foreign-tree checks cover only parent/root/index interoperability;
// they do not reproduce DummyMenuItem's listener or property update protocol.
global.__krkrns_game_k2compat = "fixture-game-layer.tjs";
Scripts.execStorage("romfs:/compat/system/k2compat.tjs");
var gameMenuChecks = 0, gameMenuClicks = 0;
function gameMenuAssert(value, label) {
    if (!value) throw new Exception("GAME MENU FAIL: " + label);
    gameMenuChecks++; Debug.message("[menu-game-layer] PASS " + label);
}
gameMenuAssert(typeof(global.MenuItem) == "Object", "released global MenuItem capability remains available to game layers");
var gameUsesDummyMenu = typeof(global.MenuItem) == "undefined";
gameMenuAssert(!gameUsesDummyMenu, "MenuItem capability selects the released derived-menu branch");
class GameDerivedMenuItem extends MenuItem {
    var gameWindow;
    function GameDerivedMenuItem(window, caption) {
        super.MenuItem(null, caption);
        gameWindow = window;
        shortcut = 0;
    }
    function onClick() { gameMenuClicks++; }
}
class GameProvidedMenuItem {
    var parent_ = null, children_, window_, caption_;
    var enabled = true, visible = true, radio = false, checked = false, group = 0;
    function GameProvidedMenuItem(window, caption) {
        window_ = window; caption_ = caption; children_ = new Array();
    }
    property parent { getter { return parent_; } }
    property children { getter { return children_; } }
    property caption { getter { return caption_; } }
    property window { getter { return window_; } }
    property root {
        getter {
            var current = this;
            while (current.parent_ !== null) current = current.parent_;
            return current;
        }
    }
    property index {
        getter { return parent_ === null ? 0 : parent_.children_.find(this); }
        setter(v) { if (parent_ !== null) parent_.insert(this, v); }
    }
    function click() { gameMenuClicks++; }
}
var gameMenuWindow = new Window(); gameMenuWindow.setInnerSize(640, 360);
var gameMenuLayer = new Layer(gameMenuWindow, null);
gameMenuLayer.setSize(640, 360); gameMenuLayer.type = ltOpaque;
gameMenuLayer.fillRect(0, 0, 640, 360, 0xff205040);
gameMenuLayer.visible = true; gameMenuWindow.visible = true;
var otherGameWindow = new Window();
gameMenuAssert(gameMenuWindow.menu.__krkrnsGameMenuRoot &&
               gameMenuWindow.menu !== otherGameWindow.menu, "game windows get independent compatibility roots");
gameMenuAssert(gameMenuWindow.menu.window_ === gameMenuWindow && gameMenuWindow.menu.parent_ === null,
               "compatibility root exposes game window and parent backing fields");
var derived = new GameDerivedMenuItem(gameMenuWindow, "Derived game menu");
gameMenuWindow.menu.add(derived);
gameMenuAssert(derived.caption == "Derived game menu" && derived.window === gameMenuWindow,
               "game subclass super.MenuItem initializes caption and resolves its Window root");
gameMenuAssert(typeof(derived.shortcut) == "String" && derived.shortcut == "0",
               "derived constructor retains the released string shortcut contract");
derived.visible = false; derived.visible = true;
gameMenuAssert(derived.visible && gameMenuWindow.menu.children.count == 1,
               "derived visible assignment preserves the released branch without Dummy updateList calls");
derived.fireClick();
gameMenuAssert(gameMenuClicks == 1, "game-derived onClick override delivers exactly once");
gameMenuWindow.menu.remove(derived); invalidate derived;
gameMenuClicks = 0;
var foreignFirst = new GameProvidedMenuItem(gameMenuWindow, "First");
var foreignLast = new GameProvidedMenuItem(gameMenuWindow, "Last");
gameMenuWindow.menu.add(foreignFirst); gameMenuWindow.menu.add(foreignLast);
gameMenuAssert(foreignFirst.parent === gameMenuWindow.menu && foreignFirst.root === gameMenuWindow.menu,
               "foreign read-only parent and root chain work through parent_ backing field");
gameMenuAssert(foreignFirst.index == 0 && foreignLast.index == 1,
               "foreign index reads authoritative root children_ array");
foreignLast.index = 0;
gameMenuAssert(gameMenuWindow.menu.children[0] === foreignLast && foreignFirst.index == 1,
               "foreign index setter reorders through compatibility root insert");
otherGameWindow.menu.add(foreignFirst);
gameMenuAssert(foreignFirst.parent === otherGameWindow.menu && gameMenuWindow.menu.children.count == 1 &&
               foreignFirst.root === otherGameWindow.menu, "foreign cross-parent add detaches the original tree");
otherGameWindow.menu.remove(foreignFirst);
gameMenuAssert(foreignFirst.parent === null && otherGameWindow.menu.children.count == 0,
               "foreign remove clears parent_ without assigning read-only parent");
var rejectedWindowRoot = false;
try { gameMenuWindow.menu.add(otherGameWindow.menu); } catch (e) { rejectedWindowRoot = true; }
gameMenuAssert(rejectedWindowRoot && otherGameWindow.menu.parent === null,
               "a Window root cannot be attached inside another tree");
gameMenuAssert(!global.__krkrnsMenuShortcut(115, 0x0040, gameMenuWindow) && gameMenuClicks == 0,
               "game-root accelerators stay with game-provided menu code");
foreignLast.click();
gameMenuAssert(gameMenuClicks == 1, "game-provided click keeps its own delivery semantics");
otherGameWindow.menu.add(foreignFirst);
invalidate otherGameWindow;
gameMenuAssert(foreignFirst.parent === null && isvalid foreignFirst,
               "compatibility root detaches foreign items without invalidating game-owned objects");
gameMenuAssert(typeof(global.MenuItem) == "Object", "Window operations preserve the released MenuItem capability branch");
Debug.message("[menu-game-layer] COMPLETE " + gameMenuChecks + " checks");
