// Native file-move regression. Writes only its dedicated test directory.
var moveChecks = 0;
function moveCheck(value, label) {
    if (!value) throw new Exception("MOVE TEST FAIL: " + label);
    moveChecks++;
    Debug.message("[storage-move] PASS " + label);
}
var moveBase = "sdmc:/switch/KRKR-ns/storage-move-test/";
function movePath(name) { return moveBase + name; }
function moveRemove(name) {
    var removed = Storages.deleteFile(movePath(name));
}
function moveSave(name, value) {
    var data = %[value: value, text: "保存 日本語 café"];
    (Dictionary.saveStruct incontextof data)(movePath(name), "b");
}
function moveRead(name) { return Dictionary.loadStruct(movePath(name)); }
var moveFiles = ["源.ksd", "目标.ksd", "occupied.ksd", "missing.ksd",
                 "void-from.ksd", "void-to.ksd", "archive-to.ksd",
                 "quick1.ksd", "quick2.ksd", "quick3.ksd"];
for (var i = 0; i < moveFiles.count; i++) moveRemove(moveFiles[i]);
moveCheck(typeof Storages.moveFile != "undefined", "native API exists");
moveSave("源.ksd", 101);
moveCheck(Storages.isExistentStorage(movePath("源.ksd")), "source cached before move");
moveCheck(!Storages.isExistentStorage(movePath("目标.ksd")), "absent target cached before move");
moveCheck(Storages.moveFile(movePath("源.ksd"),
    "file://?/sdmc:/switch/krkr-ns/storage-move-test//目标.ksd"),
    "Unicode names and normalized device paths move");
moveCheck(!Storages.isExistentStorage(movePath("源.ksd")), "source cache invalidated");
moveCheck(Storages.isExistentStorage(movePath("目标.ksd")), "target cache invalidated");
moveCheck(moveRead("目标.ksd").value == 101 &&
    moveRead("目标.ksd").text == "保存 日本語 café", "serialized content preserved");

moveSave("occupied.ksd", 202);
moveCheck(!Storages.moveFile(movePath("目标.ksd"), movePath("occupied.ksd")), "existing destination rejected");
moveCheck(moveRead("目标.ksd").value == 101 && moveRead("occupied.ksd").value == 202,
    "both files preserved when target exists");
moveCheck(!Storages.moveFile(movePath("missing.ksd"), movePath("occupied.ksd")), "missing source rejected");
moveCheck(moveRead("occupied.ksd").value == 202, "missing source leaves target intact");
moveCheck(!Storages.moveFile(movePath("目标.ksd"), movePath("no-parent/result.ksd")), "missing parent rejected");
moveCheck(moveRead("目标.ksd").value == 101, "failed move preserves source");
moveCheck(!Storages.moveFile(movePath("目标.ksd"), movePath("目标.ksd")), "same path rejected");
moveCheck(!Storages.moveFile("", movePath("目标.ksd")), "empty source rejected");
moveCheck(!Storages.moveFile(movePath("目标.ksd"), ""), "empty target rejected");

moveSave("void-from.ksd", 303);
Storages.moveFile(movePath("void-from.ksd"), movePath("void-to.ksd"));
moveCheck(!Storages.isExistentStorage(movePath("void-from.ksd")) &&
    moveRead("void-to.ksd").value == 303, "discarded return value still executes move");
moveCheck(Storages.isExistentStorage("contract.xp3>payload.txt"), "archive member exists");
moveCheck(!Storages.moveFile("contract.xp3>payload.txt", movePath("archive-to.ksd")), "archive source rejected");
moveCheck(Storages.isExistentStorage("contract.xp3>payload.txt") &&
    !Storages.isExistentStorage(movePath("archive-to.ksd")), "archive unchanged");
moveCheck(!Storages.moveFile(movePath("目标.ksd"), "contract.xp3>new.txt"), "archive destination rejected");
moveCheck(moveRead("目标.ksd").value == 101, "archive failure preserves local source");

// Mirror rolling quick-save slots, including repeated moves and cache probes.
for (var generation = 1; generation <= 4; generation++) {
    moveRemove("quick3.ksd");
    if (Storages.isExistentStorage(movePath("quick2.ksd")))
        moveCheck(Storages.moveFile(movePath("quick2.ksd"), movePath("quick3.ksd")), "older slot rotates");
    if (Storages.isExistentStorage(movePath("quick1.ksd")))
        moveCheck(Storages.moveFile(movePath("quick1.ksd"), movePath("quick2.ksd")), "newest slot rotates");
    moveSave("quick1.ksd", generation);
    moveCheck(moveRead("quick1.ksd").value == generation, "newest slot content");
    if (generation > 1) moveCheck(moveRead("quick2.ksd").value == generation - 1, "previous slot content");
    if (generation > 2) moveCheck(moveRead("quick3.ksd").value == generation - 2, "oldest slot content");
}
Debug.message("[storage-move] COMPLETE checks=" + moveChecks);
var moveWindow = new Window();
moveWindow.setInnerSize(640, 360);
moveWindow.caption = "Storage move regression passed";
var moveLayer = new Layer(moveWindow, null);
moveLayer.setSize(640, 360);
moveLayer.type = ltOpaque;
moveLayer.fillRect(0, 0, 640, 360, 0x207040);
moveLayer.visible = true;
moveWindow.visible = true;
