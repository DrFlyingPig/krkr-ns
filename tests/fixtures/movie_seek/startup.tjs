// Self-contained VideoOverlay seek/segment contract. sample.mp4 is a synthetic
// 90-frame, 30 fps clip: red 0-29, green 30-59, blue 60-89, with AAC audio.
// No game directory or save data is accessed.
var seekChecks = 0;
function seekAssert(value, label) {
    if (!value) throw new Exception("MOVIE SEEK FAIL: " + label);
    seekChecks++;
    Debug.message("[movie-seek] PASS " + label);
}
function seekColor(pixel, color) {
    var red = (pixel >> 16) & 255;
    var green = (pixel >> 8) & 255;
    var blue = pixel & 255;
    if (color == "red") return red > 120 && red > green * 2 && red > blue * 2;
    if (color == "blue") return blue > 120 && blue > red * 2 && blue > green * 2;
    return false;
}

var seekWindow = new Window();
seekWindow.setInnerSize(320, 180);
seekWindow.caption = "KRKR NS movie seek contract";
var seekRoot = new Layer(seekWindow, null);
seekRoot.setSize(320, 180);
seekRoot.type = ltOpaque;
seekRoot.fillRect(0, 0, 320, 180, 0xff203040);
seekRoot.visible = true;
var seekLayer = new Layer(seekWindow, seekRoot);
seekLayer.setSize(320, 180);
seekLayer.setImageSize(320, 180);
seekLayer.type = ltOpaque;
seekLayer.visible = true;
seekWindow.visible = true;

var seekMovie = new VideoOverlay(seekWindow);
// Segment-loop checks in VideoOvlImpl run for layer and mixer modes only.
// Mode must be selected before open(); layer1 makes onFrameUpdate observable.
seekMovie.mode = vomLayer;
seekMovie.layer1 = seekLayer;
seekMovie.open("romfs:/sample.mp4");
seekAssert(seekMovie.mode == vomLayer && seekMovie.layer1 != null,
           "layer mode and destination are active");
seekAssert(seekMovie.numberOfFrame == 90 && seekMovie.totalTime == 3000,
           "synthetic movie has the expected timeline");

var seekPhase = 0;
var seekFrameUpdates = 0;
var seekLastFrame = -1;
var seekLastPixel = 0;
var seekForwardFirst = -1;
var seekForwardAdvanced = false;
var seekBackFirst = -1;
var seekBackAdvanced = false;
var seekLoops = 0;
var seekLoopsCompleted = 0;
var seekWaitingForReturn = false;
var seekReturnFrom = -1;
var seekReturnFrame = -1;
var seekEventFailure = "";
var seekStatus = "unload";

seekMovie.onStatusChanged = function(status) {
    seekStatus = status;
    Debug.message("[movie-seek] STATUS " + status);
};
seekMovie.onFrameUpdate = function(frame) {
    try {
        var pixel = seekLayer.getMainPixel(160, 90) & 0xffffff;
        seekFrameUpdates++;
        seekLastFrame = frame;
        seekLastPixel = pixel;
        if (seekPhase == 1 || seekPhase == 2) {
            if (seekForwardFirst < 0 && frame >= 58 && frame <= 70 &&
                seekColor(pixel, "blue")) {
                seekForwardFirst = frame;
                Debug.message("[movie-seek] FORWARD first=" + frame + " pixel=" + pixel);
            } else if (seekForwardFirst >= 0 && frame >= seekForwardFirst + 3 &&
                       frame < 85 && seekColor(pixel, "blue")) {
                seekForwardAdvanced = true;
            }
        } else if (seekPhase == 3 || seekPhase == 4) {
            if (seekBackFirst < 0 && frame >= 9 && frame <= 20 &&
                seekColor(pixel, "red")) {
                seekBackFirst = frame;
                Debug.message("[movie-seek] BACK first=" + frame + " pixel=" + pixel);
            } else if (seekBackFirst >= 0 && frame >= seekBackFirst + 3 &&
                       frame <= 27 && seekColor(pixel, "red")) {
                seekBackAdvanced = true;
            }
        } else if (seekPhase == 5 && seekLoops > 0) {
            if (seekWaitingForReturn && frame >= 9 && frame <= 17 &&
                frame < seekReturnFrom && seekColor(pixel, "red")) {
                seekReturnFrame = frame;
                seekWaitingForReturn = false;
                Debug.message("[movie-seek] RETURN loop=" + seekLoops + " frame=" + frame);
            } else if (!seekWaitingForReturn && seekReturnFrame >= 0 &&
                       frame >= seekReturnFrame + 3 && frame < 30 &&
                       seekColor(pixel, "red")) {
                seekLoopsCompleted = seekLoops;
            }
        }
    } catch (e) {
        seekEventFailure = "onFrameUpdate: " + e.message;
    }
};
seekMovie.onPeriod = function(reason) {
    try {
        if (reason != perSegLoop) return;
        if (seekPhase != 5) {
            seekEventFailure = "segment event outside segment phase";
            return;
        }
        if (seekLoops > 0 && seekLoopsCompleted != seekLoops)
            seekEventFailure = "segment event repeated before a return and advance";
        if (seekLastFrame < 24)
            seekEventFailure = "segment event fired before end frame: " + seekLastFrame;
        seekLoops++;
        seekReturnFrom = seekLastFrame;
        seekReturnFrame = -1;
        seekWaitingForReturn = true;
        Debug.message("[movie-seek] SEGMENT loop=" + seekLoops + " from=" + seekReturnFrom);
        if (seekLoops > 3) {
            seekEventFailure = "segment event repeated without usable playback";
            seekMovie.cancelSegmentLoop();
        }
    } catch (e) {
        seekEventFailure = "onPeriod: " + e.message;
    }
};

seekMovie.play();
var seekTicks = 0;
var seekTimer = new Timer(function() {
    try {
        seekTicks++;
        if (seekEventFailure != "")
            throw new Exception("MOVIE SEEK FAIL: " + seekEventFailure);
        if (seekTicks > 300)
            throw new Exception("MOVIE SEEK FAIL: timeout phase=" + seekPhase +
                                " last=" + seekLastFrame + " pixel=" + seekLastPixel +
                                " updates=" + seekFrameUpdates + " loops=" + seekLoops +
                                " completed=" + seekLoopsCompleted + " status=" + seekStatus);

        if (seekPhase == 0) {
            if (seekLastFrame < 8) return;
            seekAssert(seekLastFrame < 30 && seekColor(seekLastPixel, "red"),
                       "initial frames were displayed from the red segment");
            seekPhase = 1;
            seekMovie.frame = 60;
        } else if (seekPhase == 1) {
            if (seekForwardFirst < 0) return;
            seekAssert(seekForwardFirst > 50,
                       "nonzero frame seek published a blue frame past the old position");
            seekPhase = 2;
        } else if (seekPhase == 2) {
            if (!seekForwardAdvanced) return;
            seekAssert(true, "frames continue advancing after forward seek");
            seekPhase = 3;
            seekMovie.position = 400;
        } else if (seekPhase == 3) {
            if (seekBackFirst < 0) return;
            seekAssert(seekBackFirst < seekForwardFirst,
                       "nonzero millisecond seek published an earlier red frame");
            seekPhase = 4;
        } else if (seekPhase == 4) {
            if (!seekBackAdvanced) return;
            seekAssert(true, "frames continue advancing after backward seek");
            seekMovie.setSegmentLoop(10, 30);
            seekPhase = 5;
        } else if (seekPhase == 5) {
            if (seekLoopsCompleted < 2) return;
            seekAssert(seekLoops >= 2 && seekLoopsCompleted >= 2,
                       "two segment loops returned to frame ten and advanced again");
            seekMovie.cancelSegmentLoop();
            seekPhase = 6;
        } else if (seekPhase == 6) {
            if (seekStatus != "stop") return;
            seekAssert(seekLastFrame >= 85,
                       "cancelled segment loop reached the natural end of the movie");
            seekMovie.close();
            seekLayer.visible = false;
            seekRoot.fillRect(0, 0, 320, 180, 0xff20aa55);
            seekTimer.enabled = false;
            Debug.message("[movie-seek] COMPLETE " + seekChecks + " checks");
        }
    } catch (e) {
        seekTimer.enabled = false;
        Debug.message("[movie-seek] FAIL " + e.message);
        try { seekMovie.close(); } catch (closeError) {
            Debug.message("[movie-seek] CLOSE FAIL " + closeError.message);
        }
        throw e;
    }
}, "");
seekTimer.interval = 100;
seekTimer.enabled = true;
