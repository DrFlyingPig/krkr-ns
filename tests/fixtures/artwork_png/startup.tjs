// Drive the production launcher through three gallery pages and apply image 13.
// The packager creates 18 PNGs; image 13 contains valid vpAg metadata.
Scripts.execStorage("romfs:/launcher-main.tjs");

var artworkFixturePhase = 0;
var artworkFixtureStarted = System.getTickCount();
function artworkFixtureAssert(value, label) {
    if (!value) throw new Exception("ARTWORK PNG FAIL: " + label);
    Debug.message("[artwork-png] PASS " + label);
}
var artworkFixtureHandler = null;
function artworkFixtureTick() {
    if (System.getTickCount() - artworkFixtureStarted > 60000)
        throw new Exception("ARTWORK PNG FAIL: timed out");
    if (artworkFixturePhase == 0) {
        artworkFixtureAssert(games.count == 1 && currentGame().folder == "ArtworkFixture", "isolated image gallery");
        openArtwork(); artworkFixturePhase = 1; return;
    }
    if (artworkStage != "idle") return;
    if (artworkFixturePhase >= 1 && artworkFixturePhase <= 3) {
        artworkFixtureAssert(artworkItems.count == 18, "image scan count");
        for (var i = 0; i < 6; i++)
            artworkFixtureAssert(artworkGridReady[i], "page " + artworkFixturePhase + " image " + i);
        if (artworkFixturePhase < 3) {
            pageArtwork(1, false); artworkFixturePhase++; return;
        }
        var metadataLayer = new Layer(launcherWindow, overlayLayer);
        metadataLayer.visible = false;
        var metadata = metadataLayer.loadImages(artworkItems[12].source);
        artworkFixtureAssert(int metadata.vpag_w == metadataLayer.imageWidth &&
            int metadata.vpag_h == metadataLayer.imageHeight && metadata.vpag_unit == "pixel",
            "game image loading preserves vpAg metadata");
        invalidate metadataLayer;
        artworkSelected = 12;
        Debug.message("[artwork-png] source=" + artworkItems[12].source);
        applyArtwork(); artworkFixturePhase = 4; return;
    }
    if (artworkFixturePhase == 4) {
        artworkFixtureAssert(currentGame().previewPath != "", "preview selection saved");
        artworkFixtureAssert(artworkItems[12].gridFailed == false, "vpAg PNG thumbnail decoded");
        closeArtwork();
        Debug.message("[artwork-png] preview=" + currentGame().previewPath);
        artworkFixtureAssert(uiActiveEntry.previewLoaded, "selected cover displayed in launcher");
        Debug.message("[artwork-png] COMPLETE");
        System.removeContinuousHandler(artworkFixtureHandler);
    }
}
artworkFixtureHandler = function(tick) { artworkFixtureTick(); };
System.addContinuousHandler(artworkFixtureHandler);
