// Synthetic 3-second H.264/AAC MP4 only; no game scripts or saves.
var movieChecks = 0;
function movieAssert(value, label) {
    if (!value) throw new Exception("MOVIE CONTRACT FAIL: " + label);
    movieChecks++;
    Debug.message("[movie-contract] PASS " + label);
}
var movieWindow = new Window();
movieWindow.setInnerSize(320, 180);
movieWindow.caption = "KRKR NS movie contract";
var movieRoot = new Layer(movieWindow, null);
movieRoot.setSize(320, 180);
movieRoot.fillRect(0, 0, 320, 180, 0xff203040);
movieRoot.visible = true;
movieWindow.visible = true;
var movie = new VideoOverlay(movieWindow);
movie.open("romfs:/sample.mp4");
movie.setBounds(0, 0, 320, 180);
movie.visible = true;
movieAssert(movie.position == 0, "initial position is zero milliseconds");
movieAssert(movie.playRate == 1, "actual fixed playback rate is one");
movieAssert(movie.audioBalance == 0, "actual stereo balance is centered");
movieAssert(movie.audioVolume == 100000, "initial volume uses linear TVP units");
movie.audioVolume = 25000;
movieAssert(movie.audioVolume == 25000, "volume setter reaches the Switch backend");
movie.audioVolume = -1;
movieAssert(movie.audioVolume == 0, "volume clamps below zero");
movie.audioVolume = 100001;
movieAssert(movie.audioVolume == 100000, "volume clamps above full scale");
movie.audioVolume = 25000;
movieAssert(movie.numberOfAudioStream == 1 && movie.enabledAudioStream == 0,
            "first audio track is reported as ordinal zero");
movieAssert(movie.numberOfVideoStream == 1 && movie.enabledVideoStream == 0,
            "first video track is reported as ordinal zero");
movieAssert(movie.numberOfFrame == 90 && movie.totalTime == 3000,
            "synthetic movie reports its actual duration and frame count");
movieAssert(movie.mixingMovieAlpha == 1, "actual movie alpha is opaque");
movieAssert((movie.mixingMovieBGColor & 0xffffffff) == 0xff000000,
            "default mixing background is deterministic black");
movie.play();
var moviePhase = 0;
var moviePolls = 0;
var moviePauseTime = 0;
var movieTimer = new Timer(function() {
    try {
        moviePolls++;
        if (moviePolls > 80) throw new Exception("MOVIE CONTRACT FAIL: playback timeout");
        if (moviePhase == 0) {
            if (movie.position < 300) return;
            movieAssert(movie.position <= movie.totalTime,
                        "position advances within the actual movie duration");
            movie.audioVolume = 50000;
            movieAssert(movie.audioVolume == 50000, "volume updates during playback");
            movie.pause();
            moviePhase = 1;
        } else if (moviePhase == 1) {
            // Let the decoder reach its pause checkpoint before comparing.
            moviePauseTime = movie.position;
            moviePhase = 2;
        } else if (moviePhase == 2) {
            movieAssert(movie.position == moviePauseTime,
                        "position stays frozen after pause settles");
            movie.play();
            moviePhase = 3;
        } else if (moviePhase == 3) {
            if (movie.position <= moviePauseTime) return;
            movieAssert(true, "position advances after resume");
            movie.close();
            movieAssert(movie.position == 0 && movie.enabledAudioStream == -1 &&
                        movie.enabledVideoStream == -1,
                        "closed overlay reports no active tracks or position");
            movieAssert(movie.mixingMovieBGColor == 0,
                        "closed overlay background getter is initialized");
            movieTimer.enabled = false;
            Debug.message("[movie-contract] COMPLETE " + movieChecks + " checks");
        }
    } catch (e) {
        movieTimer.enabled = false;
        Debug.message("[movie-contract] FAIL " + e.message);
        throw e;
    }
}, "");
movieTimer.interval = 200;
movieTimer.enabled = true;
