global.__krkrns_game_k2compat = "";
Scripts.execStorage("romfs:/compat/system/k2compat.tjs");
var menuWin = new Window();
menuWin.setInnerSize(960, 540);
menuWin.caption = "KRKR menu script popup";
var menuCanvas = new Layer(menuWin, null);
menuCanvas.setSize(960, 540); menuCanvas.type = ltOpaque;
menuCanvas.fillRect(0, 0, 960, 540, 0x183d36);
menuCanvas.visible = true; menuWin.visible = true;
var menuClicks = 0;
var owner = new Dictionary();
owner.action = function(event) {
    if (event.type != "onClick") throw new Exception("script menu action event type mismatch");
    var item = event.target;
    if (global.__krkrnsMenuActive) throw new Exception("menu remained active during callback");
    menuClicks++;
    Debug.message("[menu-ui] CLICK " + item.caption + " total=" + menuClicks + " checked=" + item.checked);
} incontextof global;
var menuRoot = menuWin.menu;
menuRoot.caption = "Script menu";
var hidden = new MenuItem(owner, "Hidden must not appear"); hidden.visible = false; menuRoot.add(hidden);
var disabled = new MenuItem(owner, "Disabled must not click"); disabled.enabled = false; menuRoot.add(disabled);
menuRoot.add(new MenuItem(null, "-"));
var submenu = new MenuItem(null, "Options"); menuRoot.add(submenu);
var checked = new MenuItem(owner, "Checked stays checked"); checked.checked = true; submenu.add(checked);
var radioA = new MenuItem(owner, "Radio A"), radioB = new MenuItem(owner, "Radio B");
radioA.radio = true; radioB.radio = true; radioA.group = 1; radioB.group = 1;
submenu.add(radioA); submenu.add(radioB); radioA.checked = true;
var command = new MenuItem(owner, "Save command"); command.shortcut = "Ctrl+S"; menuRoot.add(command);
for (var i = 0; i < 16; i++) menuRoot.add(new MenuItem(owner, "Scrollable command " + i));
menuWin.onKeyDown = function(key, shift) {
    if (key == 0x70) menuRoot.popup(0, 180, 35);
} incontextof global;
menuWin.onKeyUp = function(key, shift) {
    if (key == 13 || key == 27 || key == 32 || (key >= 37 && key <= 40))
        throw new Exception("SCRIPT MENU INPUT LEAK: game received menu key release " + key);
    Debug.message("[menu-ui] GAME_KEYUP " + key + " shift=" + shift);
} incontextof global;
menuWin.onMouseUp = function(x, y, button, shift) {
    throw new Exception("SCRIPT MENU INPUT LEAK: game received menu pointer release");
} incontextof global;
if (menuRoot.popup(0, 180, 35) != 1) throw new Exception("script popup failed");
Debug.message("[menu-ui] READY: arrows/Enter/Esc, touch, wheel; F1 reopens, Ctrl+S fires once");
