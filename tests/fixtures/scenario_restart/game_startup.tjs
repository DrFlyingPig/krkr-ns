// The builder substitutes a different expected tag and color for each game.
var gameWindow = new Window();
gameWindow.setInnerSize(640, 360);
var gameLayer = new Layer(gameWindow, null);
gameLayer.setSize(640, 360);
gameLayer.type = ltOpaque;
gameLayer.fillRect(0, 0, 640, 360, @COLOR@);
gameLayer.visible = true;
gameWindow.visible = true;

var parser = new KAGParser();
parser.loadScenario("first.ks");
var tag = parser.getNextTag();
if (tag.tagname != "@TAG@")
    throw new Exception("SCENARIO RESTART FAIL: expected @TAG@, got " + tag.tagname);
Debug.message("[scenario-restart] PASS first.ks belongs to @TAG@");

// End the game after startup and presentation. System.exit uses the native
// return-to-launcher path, including Window cleanup and a fresh script engine.
var closeTimer = new Timer(global);
closeTimer.interval = 1500;
closeTimer.onTimer = function() {
    Debug.message("[scenario-restart] end session @TAG@");
    System.exit(0);
} incontextof global;
closeTimer.enabled = true;
