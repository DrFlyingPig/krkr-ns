// Runtime contract fixture for Kirikiroid2-compatible XP3 filters.
// Both this script and payload.tjs are XOR-encrypted inside contract.xp3.
global.xp3ContractPayload = "missing";
Scripts.execStorage("payload.tjs");
if (global.xp3ContractPayload != "decrypted-through-content-context")
    throw new Exception("XP3 CONTRACT FAIL: encrypted payload did not execute");

Debug.message("[xp3-contract] STARTUP PASS payload=" + global.xp3ContractPayload);

var xp3Window = new Window();
xp3Window.setInnerSize(640, 360);
xp3Window.caption = "KRKR NS XP3 filter contract";
var xp3Root = new Layer(xp3Window, null);
xp3Root.setSize(640, 360);
xp3Root.type = ltOpaque;
xp3Root.fillRect(0, 0, 640, 360, 0x185c2f);
xp3Root.visible = true;
xp3Window.visible = true;

