// Explicit plugin registration is the production native-menu entry point.
Plugins.link("menu.dll");
global.__krkrns_game_k2compat = "";
Scripts.execStorage("romfs:/compat/system/k2compat.tjs");
var menuChecks = 0;
function menuAssert(value, label) {
    if (!value) throw new Exception("NATIVE MENU FAIL: " + label);
    menuChecks++; Debug.message("[menu-native] PASS " + label);
}
menuAssert(global.MenuItem === global.__krkrnsNativeMenuClass,
           "compat loading preserves the explicitly linked native MenuItem class");
var menuWin = new Window();
menuWin.setInnerSize(960, 540);
menuWin.caption = "KRKR native menu popup";
var menuCanvas = new Layer(menuWin, null);
menuCanvas.setSize(960, 540); menuCanvas.type = ltOpaque;
menuCanvas.fillRect(0, 0, 960, 540, 0x18283f);
menuCanvas.visible = true; menuWin.visible = true;
var otherWin = new Window();
menuAssert(menuWin.menu.__krkrnsNativeMenu && menuWin.menu !== otherWin.menu,
           "explicit plugin creates separate native Window roots");
menuAssert(menuWin.menu.window === menuWin, "native root resolves its Window");
var root = menuWin.menu;
root.caption = "Native menu";
var cachedNativeChildren = root.children;
menuAssert(cachedNativeChildren === root.children, "native children Array keeps identity");
var a = new MenuItem(null, "A"), b = new MenuItem(null, "B"), c = new MenuItem(null, "C");
root.add(a); root.add(b); root.add(c); c.index = 0;
menuAssert(c.index == 0 && root.children[0] === c && a.index == 1, "native index reorders siblings");
menuAssert(root.children === cachedNativeChildren && cachedNativeChildren[0] === c,
           "native children cache refreshes in place after tree mutations");
root.add(a); menuAssert(root.children.count == 3 && a.index == 1, "duplicate native add is stable");
otherWin.menu.add(a);
menuAssert(root.children.count == 2 && a.parent === otherWin.menu && a.window === otherWin,
           "native cross-parent reparenting updates Window");
var rejected = false;
try { c.add(root); } catch (e) { rejected = true; }
menuAssert(rejected && c.parent === root, "native tree rejects ancestor cycles");
b.radio = true; c.radio = true; b.group = 2; c.group = 2;
b.checked = true; c.checked = true;
menuAssert(c.checked && !b.checked, "native radio mutual exclusion");
root.remove(b); root.remove(c);
var clicks = 0, closed = false;
var action = new Dictionary();
action.action = function(event) {
    if (event.type != "onClick" || event.target !== choice) throw new Exception("native action event envelope mismatch");
    clicks++; closed = !global.__krkrnsMenuActive;
} incontextof global;
var choice = new MenuItem(action, "Choice"); choice.checked = true; choice.shortcut = "Ctrl+S"; root.add(choice);
menuAssert(global.__krkrnsMenuShortcut(115, 0x0040, menuWin) && clicks == 1,
           "native accelerator routes one onClick to action owner");
root.enabled = false; choice.fireClick();
menuAssert(clicks == 1, "native disabled ancestor suppresses event"); root.enabled = true;
menuAssert(root.popup(0, 180, 35) == 1 && global.__krkrnsMenuActive, "native popup opens layer view");
global.__krkrnsMenuInput("keyDown", 13, 0, 0);
menuAssert(clicks == 2 && closed && choice.checked && !global.__krkrnsMenuActive,
           "native selection closes first, fires once, and leaves checked unchanged");
root.popup(0, 180, 35); global.__krkrnsMenuInput("keyDown", 27, 0, 0);
menuAssert(clicks == 2 && !global.__krkrnsMenuActive, "native Escape cancels");

var subclassClicks = 0;
class NativeMenuSubclass extends MenuItem {
    function NativeMenuSubclass(owner, caption) { super.MenuItem(owner, caption); }
    function onClick() { subclassClicks++; }
}
var subclassItem = new NativeMenuSubclass(null, "Subclass item");
root.add(subclassItem);
menuAssert(subclassItem.__krkrnsNativeMenu && subclassItem.caption == "Subclass item" &&
           subclassItem.window === menuWin, "subclass retains its native instance and inherited properties");
subclassItem.fireClick();
menuAssert(subclassClicks == 1 && clicks == 2, "subclass fireClick invokes its overridden onClick once");
root.remove(subclassItem); invalidate subclassItem;

var disposable = new MenuItem(null, "Disposable child"); root.add(disposable);
var countBeforeInvalidate = root.children.count;
invalidate disposable;
menuAssert(root.children.count == countBeforeInvalidate - 1 && root.children.find(disposable) < 0,
           "explicit child invalidation removes it from its parent tree");

var popupWindow = new Window(); popupWindow.setInnerSize(320, 180);
var popupPrimary = new Layer(popupWindow, null); popupPrimary.setSize(320, 180);
popupPrimary.type = ltOpaque; popupPrimary.fillRect(0, 0, 320, 180, 0xff304050);
popupPrimary.visible = true; popupWindow.visible = true;
popupWindow.menu.add(new MenuItem(null, "Temporary command"));
menuAssert(popupWindow.menu.popup(0, 0, 0) == 1 && global.__krkrnsMenuActive,
           "temporary native Window can own an active popup");
invalidate popupWindow;
menuAssert(!global.__krkrnsMenuActive && global.__krkrnsMenuView === null,
           "explicit Window invalidation closes and releases its active popup");
invalidate otherWin;
Debug.message("[menu-native] COMPLETE " + menuChecks + " checks");
action.action = function(event) {
    if (event.type != "onClick") throw new Exception("native action event type mismatch");
    var item = event.target;
    if (global.__krkrnsMenuActive) throw new Exception("native callback before popup closed");
    clicks++; Debug.message("[menu-native] CLICK " + item.caption + " total=" + clicks + " checked=" + item.checked);
} incontextof global;
root.remove(choice);
choice.shortcut = ""; // The initial contract already exercised this accelerator.
var hidden = new MenuItem(action, "Hidden must not appear"); hidden.visible = false; root.add(hidden);
var disabled = new MenuItem(action, "Disabled must not click"); disabled.enabled = false; root.add(disabled);
root.add(new MenuItem(null, "-"));
var options = new MenuItem(null, "Options"); root.add(options);
options.add(choice); options.add(b); options.add(c); c.checked = true;
var command = new MenuItem(action, "Save command"); command.shortcut = "Ctrl+S"; root.add(command);
for (var i = 0; i < 16; i++) root.add(new MenuItem(action, "Scrollable command " + i));
menuWin.onKeyDown = function(key, shift) { if (key == 0x70) root.popup(0, 180, 35); } incontextof global;
menuWin.onKeyUp = function(key, shift) {
    if (key == 13 || key == 27 || key == 32 || (key >= 37 && key <= 40))
        throw new Exception("NATIVE MENU INPUT LEAK: game received menu key release " + key);
    Debug.message("[menu-native] GAME_KEYUP " + key + " shift=" + shift);
} incontextof global;
menuWin.onMouseUp = function(x, y, button, shift) {
    throw new Exception("NATIVE MENU INPUT LEAK: game received menu pointer release");
} incontextof global;
root.popup(0, 180, 35);
Debug.message("[menu-native] READY: arrows/Enter/Esc, touch, wheel; F1 reopens, Ctrl+S fires once");
