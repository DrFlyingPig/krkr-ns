// Uses the same synthetic 90-frame RGB/AAC clip as movie_seek.
// Exercises default overlay mode, including paused and stopped seeks.
var overlayChecks = 0;
function overlayAssert(value, label) {
    if (!value) throw new Exception("OVERLAY SEEK FAIL: " + label);
    overlayChecks++;
    Debug.message("[overlay-seek] PASS " + label);
}
var overlayWindow = new Window();
overlayWindow.setInnerSize(320, 180);
overlayWindow.caption = "KRKR NS overlay seek contract";
var overlayRoot = new Layer(overlayWindow, null);
overlayRoot.setSize(320, 180);
overlayRoot.fillRect(0, 0, 320, 180, 0xff203040);
overlayRoot.visible = true;
overlayWindow.visible = true;
var overlayMovie = new VideoOverlay(overlayWindow);
overlayMovie.open("romfs:/sample.mp4");
overlayMovie.setBounds(0, 0, 320, 180);
overlayMovie.visible = true;
overlayAssert(overlayMovie.mode == vomOverlay, "default display mode is overlay");
overlayMovie.position = 1500;
overlayAssert(overlayMovie.frame == 45 && overlayMovie.position == 1500,
              "stopped seek keeps an absolute zero-based frame and time");
var overlayLast = -1;
var overlayStatus = "stop";
var overlayPhase = 0;
var overlayTicks = 0;
var overlayHeld = 0;
var overlayLoops = 0;
var overlayReturned = 0;
var overlayAdvanced = 0;
var overlayFailure = "";
overlayMovie.onFrameUpdate = function(frame) {
    overlayLast = frame;
    if (overlayPhase == 3 && overlayLoops > 0) {
        if (frame >= 10 && frame <= 15) overlayReturned = overlayLoops;
        if (overlayReturned == overlayLoops && frame >= 18 && frame < 30)
            overlayAdvanced = overlayLoops;
    }
};
overlayMovie.onStatusChanged = function(status) { overlayStatus = status; };
overlayMovie.onPeriod = function(reason) {
    if (reason != perSegLoop) return;
    if (overlayPhase != 3) overlayFailure = "loop fired while paused";
    if (overlayLoops > 0 && overlayAdvanced != overlayLoops)
        overlayFailure = "loop repeated before actual return and progression";
    overlayLoops++;
    Debug.message("[overlay-seek] LOOP " + overlayLoops);
};
overlayMovie.play();
var overlayTimer = new Timer(function() {
    try {
        overlayTicks++;
        if (overlayFailure != "") throw new Exception(overlayFailure);
        if (overlayTicks > 200) throw new Exception("timeout phase=" + overlayPhase);
        if (overlayPhase == 0) {
            if (overlayLast < 48) return;
            // Cold renderer initialization can delay this Timer beyond 2s.
            // The stopped property assertion above checks the exact target;
            // here verify forward progression without assuming callback latency.
            overlayAssert(overlayLast >= 45 && overlayLast < 90,
                          "play starts at the stopped seek position");
            overlayMovie.pause();
            overlayPhase = 1;
            overlayMovie.frame = 60;
        } else if (overlayPhase == 1) {
            if (overlayLast != 60) return;
            overlayAssert(overlayStatus == "pause" && overlayMovie.frame == 60,
                          "paused seek publishes the target frame and stays paused");
            overlayMovie.setSegmentLoop(10, 30);
            overlayPhase = 2;
            Debug.message("[overlay-seek] PAUSED_BLUE");
        } else if (overlayPhase == 2) {
            overlayHeld++;
            if (overlayHeld < 50) return;
            overlayAssert(overlayLast == 60 && overlayMovie.frame == 60 && overlayLoops == 0,
                          "paused seek beyond a segment boundary does not loop");
            overlayPhase = 3;
            overlayMovie.play();
        } else if (overlayPhase == 3) {
            if (overlayAdvanced < 2) return;
            overlayAssert(overlayLoops >= 2 && overlayReturned >= 2,
                          "default overlay loops twice with actual frame progression");
            overlayMovie.cancelSegmentLoop();
            overlayPhase = 4;
        } else if (overlayPhase == 4) {
            if (overlayStatus != "stop") return;
            overlayAssert(overlayLast >= 85, "cancel reaches natural end in overlay mode");
            overlayMovie.frame = 0;
            overlayAssert(overlayMovie.frame == 0 && overlayMovie.position == 0,
                          "seek after EOF returns to frame zero");
            overlayLast = -1;
            overlayPhase = 5;
            overlayMovie.play();
        } else if (overlayPhase == 5) {
            if (overlayLast < 3 || overlayLast > 15) return;
            overlayAssert(true, "play resumes and advances after EOF seek");
            overlayMovie.close();
            overlayRoot.fillRect(0, 0, 320, 180, 0xff20aa55);
            overlayTimer.enabled = false;
            Debug.message("[overlay-seek] COMPLETE " + overlayChecks + " checks");
        }
    } catch (e) {
        overlayTimer.enabled = false;
        Debug.message("[overlay-seek] FAIL " + e.message);
        overlayMovie.close();
        throw e;
    }
}, "");
overlayTimer.interval = 100;
overlayTimer.enabled = true;
